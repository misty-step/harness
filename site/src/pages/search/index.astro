---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getGraph } from '../../lib/content.mjs';
const graph = await getGraph();
const sections = [...new Set(graph.documents.map((document) => document.kind))].sort();
---
<SiteLayout title="Search" section="Search" noindex>
  <div class="container section">
    <h1>Search the method</h1>
    <p>Find names, phrases, prevented failures and the heading to share.</p>
    <form class="search-form" action="/search/" method="get" data-search-form>
      <label>Search<input name="q" type="search" autocomplete="off" placeholder="Try outside proof or bug fix" /></label>
      <label>Section<select name="section"><option value="">All sections</option>{sections.map((section) => <option value={section}>{section}</option>)}</select></label>
      <button type="submit">Search</button>
    </form>
    <noscript><p>Search needs JavaScript. All content is readable without it: <a href="/library/">browse the library</a> or <a href="/guide/">follow the guide</a>.</p></noscript>
    <p class="search-status" role="status" aria-live="polite" data-search-status>Enter a term to search this revision.</p>
    <ol class="search-results" role="list" data-search-results></ol>
    <button type="button" data-search-more hidden>Show more results</button>
    <p><a href="/library/">Browse the full library</a> · <a href="/guide/">Follow the guide</a></p>
  </div>
  <script>import '../../scripts/search.mjs';</script>
</SiteLayout>
