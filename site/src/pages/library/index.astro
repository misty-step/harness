---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getGraph } from '../../lib/content.mjs';
import { catalogKinds } from '../../lib/graph.mjs';
const graph = await getGraph();
const documents = graph.documents.filter((document) => catalogKinds.includes(document.kind));
---
<SiteLayout title="Library" section="Library">
  <div class="container section">
    <h1>Library</h1>
    <p>The complete method, including principle leaves hidden from automatic model discovery. Supporting documents are linked from each entry.</p>
    <form class="catalog-controls" action="/library/" method="get" data-catalog-controls hidden>
      <label>Find an entry<input type="search" name="q" placeholder="Name, trigger or prevented failure" /></label>
      <label>Section<select name="section"><option value="">All sections ({documents.length})</option>{catalogKinds.map((kind) => <option value={kind}>{kind} ({documents.filter((document) => document.kind === kind).length})</option>)}</select></label>
      <button type="submit">Filter library</button>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-catalog-status>{documents.length} entries</p>
    <noscript><p>All entries are available below. Filtering and search need JavaScript.</p></noscript>
    <ul class="catalog-list" role="list">{documents.map((document) => <li class="catalog-item" data-catalog-item data-section={document.kind} data-search={`${document.title} ${document.skill?.name ?? ''} ${document.skill?.description ?? ''} ${document.skill?.prevents ?? ''}`.toLowerCase()}>
      <div class="catalog-meta"><span class="badge">{document.kind}</span>{document.skill?.disableModelInvocation && <span>Explicit invocation</span>}</div>
      <h2><a href={document.url}>{document.title}</a></h2>
      {document.skill && <><p>{document.skill.description}</p><p><strong>Prevents:</strong> {document.skill.prevents}</p></>}
      {!document.skill && <p><code>{document.id}</code></p>}
    </li>)}</ul>
    <p data-catalog-empty hidden>No matching entries. Clear the filters or <a href="/guide/">follow the guide</a>.</p>
  </div>
  <script>import '../../scripts/catalog.mjs';</script>
</SiteLayout>
