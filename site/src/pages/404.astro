---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found" section="About" path="/404.html" noindex>
  <div class="page">
    <section class="s s-cta">
      <h1 class="s-title">Page not found</h1>
      <p class="s-intro">This address does not identify a page in this revision.</p>
      <div class="actions"><a class="btn btn-primary" href="/search/">Search the method</a><a class="btn btn-quiet" href="/library/">Browse the library</a></div>
      <p class="s-intro"><a href="/">Go to the home page</a> or <a href="/guide/">follow the guide</a>.</p>
    </section>
  </div>
</SiteLayout>
