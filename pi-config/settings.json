{
  "theme": "system",
  "defaultProvider": "openai-pool",
  "defaultModel": "gpt-6.1-sol",
  "modelThinkingLevels": {
    "openai-pool/gpt-6-astra": "xhigh",
    "openai-pool/gpt-6.1-sol": "xhigh",
    "openai-codex/gpt-6-astra": "xhigh",
    "openai-codex/gpt-6.1-sol": "xhigh",
    "openai-codex-2/gpt-6-astra": "xhigh",
    "openai-codex-2/gpt-6.1-sol": "xhigh",
    "openai-codex-3/gpt-6-astra": "xhigh",
    "openai-codex-3/gpt-6.1-sol": "xhigh",
    "openai-codex-4/gpt-6-astra": "xhigh",
    "openai-codex-4/gpt-6.1-sol": "xhigh"
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "compaction": {
    "enabled": true
