{
  "theme": "omarchy-system",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5-5": "medium",
    "anthropic/claude-opus-5-5": "high",
    "openai-codex/gpt-6-astra": "medium",
    "openai-codex/gpt-6-sol": "xhigh",
    "openai-codex/gpt-6-luna": "max"
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "editorPaddingX": 2,
  "outputPad": 1,
  "fullscreenScrollbar": "always",
  "markdown": {
    "codeBlockIndent": "  "
  }
}
