#!/bin/sh
# Deploy the shared primitives Claude Code sessions (T3 lanes) select.
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
base_dir=${AGENT_CONFIG_DIR:-$repo_dir/../agent-config}

[ "$#" -eq 0 ] || {
  echo 'install takes no arguments' >&2
  exit 1
}
[ -f "$base_dir/install" ] || {
  printf 'agent-config installer not found at %s; set AGENT_CONFIG_DIR\n' "$base_dir" >&2
  exit 1
}

skills='lage ship-loop judge release-watch heartbeat story-qa pokayoke user-stories authenticated-commands'
guidance='engineering workstation autonomy'
owned='<!-- owned by misty-step/harness claude-config -->'

# ~/.claude/CLAUDE.md is the user-scope file Claude Code always loads (an
# AGENTS.md there loads only as a fallback in projects without a CLAUDE.md).
# Replace it only when it is ours.
target="$agent_dir/CLAUDE.md"
if [ -e "$target" ] && [ "$(head -n 1 "$target")" != "$owned" ]; then
  printf '%s is not ours; move its content into a repository CLAUDE.md or remove it, then rerun\n' "$target" >&2
  exit 1
fi

set --
for skill in $skills; do set -- "$@" --skill "$skill"; done
for section in $guidance; do set -- "$@" --guidance "$section"; done
set -- "$@" --bin t3-runtime-mode.ts --t3-pool
set -- "$@" --guidance-source "$repo_dir/global/CLAUDE.md" --guidance-file CLAUDE.md
"$base_dir/install" --check --agent-dir "$agent_dir" "$@"
"$base_dir/install" --agent-dir "$agent_dir" "$@"
printf 'claude: installed %s, t3-runtime-mode and guidance (%s) into %s\n' "$skills" "$guidance" "$agent_dir"
