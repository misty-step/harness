#!/bin/sh
# Deploy the shared primitives Claude Code sessions (T3 lanes) select.
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
base_dir=${AGENT_CONFIG_DIR:-$repo_dir/../agent-config}

[ "$#" -eq 0 ] || {
  echo 'install takes no arguments' >&2
  exit 1
}
[ -f "$base_dir/install" ] || {
  printf 'agent-config installer not found at %s; set AGENT_CONFIG_DIR\n' "$base_dir" >&2
  exit 1
}

skills='lage ship-loop judge release-watch heartbeat lane-succession story-qa pokayoke user-stories authenticated-commands daybook-sync remote-execution t3-access'
guidance='engineering workstation autonomy'

# Validate canonical guidance and the legacy entry before any write.
python3 "$base_dir/lib/canonical_instructions.py" check "$agent_dir"
python3 "$repo_dir/agents-hook.py" check "$agent_dir"

set --
for skill in $skills; do set -- "$@" --skill "$skill"; done
for section in $guidance; do set -- "$@" --guidance "$section"; done
set -- "$@" --bin t3-runtime-mode.ts --bin t3-agent --bin agent-accounts --bin daybook-sync --bin workstation-guard --bin remote-run.ts --t3-pool
set -- "$@" --guidance-source "$repo_dir/global/AGENTS.md" --guidance-file AGENTS.md
"$base_dir/install" --check --agent-dir "$HOME/.agents" --preserve-foreign-skills --skill daybook-sync --skill t3-access
"$base_dir/install" --check --agent-dir "$agent_dir" "$@"
python3 "$base_dir/lib/canonical_instructions.py" migrate "$agent_dir"
"$base_dir/install" --agent-dir "$agent_dir" "$@"
"$base_dir/install" --agent-dir "$HOME/.agents" --preserve-foreign-skills --skill daybook-sync --skill t3-access
python3 "$repo_dir/agents-hook.py" install "$agent_dir"
printf 'claude: installed %s, t3-runtime-mode, workstation-guard and guidance (%s) into %s\n' "$skills" "$guidance" "$agent_dir"
