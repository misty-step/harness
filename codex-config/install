#!/bin/sh
# Deploy the shared primitives Codex sessions select.
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${CODEX_HOME:-$HOME/.codex}
base_dir=${AGENT_CONFIG_DIR:-$repo_dir/../agent-config}

[ "$#" -eq 0 ] || {
  echo 'install takes no arguments' >&2
  exit 1
}
[ -f "$base_dir/install" ] || {
  printf 'agent-config installer not found at %s; set AGENT_CONFIG_DIR\n' "$base_dir" >&2
  exit 1
}

skills='lage ship-loop judge release-watch heartbeat story-qa pokayoke user-stories authenticated-commands daybook-sync remote-execution'
guidance='engineering workstation autonomy'
owned='<!-- owned by misty-step/harness codex-config -->'

# $CODEX_HOME/AGENTS.md is Codex's global instructions file; its skills load
# from $CODEX_HOME/skills. config.toml is touched only by Codex's own RPC, to
# trust the workstation guard hook. Replace AGENTS.md only
# when it is ours.
target="$agent_dir/AGENTS.md"
if [ -e "$target" ] || [ -L "$target" ]; then
  if [ ! -f "$target" ] || [ -L "$target" ] || [ "$(head -n 1 "$target")" != "$owned" ]; then
    printf '%s is not ours; move its content into a repository AGENTS.md or remove it, then rerun\n' "$target" >&2
    exit 1
  fi
fi

set -- --preserve-foreign-skills --bin daybook-sync --bin workstation-guard --bin remote-run.ts
for skill in $skills; do set -- "$@" --skill "$skill"; done
for section in $guidance; do set -- "$@" --guidance "$section"; done
set -- "$@" --guidance-source "$repo_dir/global/AGENTS.md" --guidance-file AGENTS.md
"$base_dir/install" --check --agent-dir "$HOME/.agents" --preserve-foreign-skills --skill daybook-sync --skill heartbeat --skill lage
"$base_dir/install" --check --agent-dir "$agent_dir" "$@"
python3 "$repo_dir/pretool-hook.py" check "$agent_dir"
"$base_dir/install" --agent-dir "$agent_dir" "$@"
"$base_dir/install" --agent-dir "$HOME/.agents" --preserve-foreign-skills --skill daybook-sync --skill heartbeat --skill lage
python3 "$repo_dir/pretool-hook.py" install "$agent_dir"
# Codex loads AGENTS.override.md in place of AGENTS.md when it exists.
if [ -e "$agent_dir/AGENTS.override.md" ]; then
  printf 'warning: %s/AGENTS.override.md shadows the installed AGENTS.md\n' "$agent_dir" >&2
fi
printf 'codex: installed %s, workstation-guard and guidance (%s) into %s\n' "$skills" "$guidance" "$agent_dir"
