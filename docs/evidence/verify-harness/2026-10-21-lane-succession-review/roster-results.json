{
  "expressionFromInstalledSkill": ".wipRoots | type == \"array\" and all(.[]; type == \"string\" and test(\"\\\\S\")) and length == (unique | length)",
  "results": [
    {
      "case": "unique",
      "input": {
        "wipRoots": [
          "root",
          "other"
        ]
      },
      "exit": 0,
      "expectedValid": true
    },
    {
      "case": "empty",
      "input": {
        "wipRoots": []
      },
      "exit": 0,
      "expectedValid": true
    },
    {
      "case": "duplicate",
      "input": {
        "wipRoots": [
          "root",
          "root"
        ]
      },
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "blank",
      "input": {
        "wipRoots": [
          " "
        ]
      },
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "nonstring",
      "input": {
        "wipRoots": [
          1
        ]
      },
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "missing-key",
      "input": {},
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "not-array",
      "input": {
        "wipRoots": "root"
      },
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "null",
      "input": {
        "wipRoots": null
      },
      "exit": 1,
      "expectedValid": false
    },
    {
      "case": "malformed",
      "exit": 5,
      "expectedValid": false
    },
    {
      "case": "missing-file",
      "exit": 2,
      "expectedValid": false
    }
  ]
}
