#!/bin/sh
# Pre-push secret scanning for mistystack.
set -eu
cd "$(git rev-parse --show-toplevel)"

command -v gitleaks >/dev/null 2>&1 || {
  printf 'gitleaks is required for pre-push secret scanning\n' >&2
  exit 1
}
zero=0000000000000000000000000000000000000000
updates_file=$(mktemp)
trap 'rm -f "$updates_file"' 0 HUP INT TERM
tee "$updates_file" >/dev/null
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue
  # Scan exactly the commits that no remote ref has ever contained — the same
  # range for new and existing branches. A "$remote_oid..$local_oid" range
  # re-scans already-public commits after a rebase or force-push: rebasing
  # rewrites SHAs, so every commit between the old branch head and the new
  # head looks outgoing. Gitleaks then blocks legitimate pushes on findings
  # that are already on the remote (observed with redaction fixtures on main).
  log_opts="$local_oid --not --remotes"
  gitleaks git . --log-opts="$log_opts" --redact --no-banner || {
    printf 'gitleaks found a potential secret in outgoing commits\n' >&2
    exit 1
  }
done < "$updates_file"
command -v trufflehog >/dev/null 2>&1 || {
  printf 'trufflehog is required for pre-push secret scanning\n' >&2
  exit 1
}
python3 .githooks/trufflehog-gate.py || {
  printf 'trufflehog found a potential secret; inspect locally before pushing\n' >&2
  exit 1
}
