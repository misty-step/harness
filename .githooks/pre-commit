#!/bin/sh
# pre-commit — deterministic scanners block; Jev review is advisory context only.
#
# Policy (from the principal):
# - Deterministic checks BLOCK when a configured scanner finds real problems.
# - Jev is ALWAYS advisory context at hooks. A model probability is never the
#   sole gate, and a Jev outage changes nothing about deterministic enforcement.
set -eu
cd "$(git rev-parse --show-toplevel)"

# Step 1 (deterministic, blocking): scan EXACT staged content.
command -v gitleaks >/dev/null 2>&1 || {
  printf 'gitleaks is required for pre-commit secret scanning\n' >&2
  exit 1
}
gitleaks protect --staged --redact --no-banner || {
  printf 'gitleaks found a potential secret in staged content; commit refused\n' >&2
  exit 1
}

# Step 2 (Jev, advisory only): never changes the exit status.
# review-check's redaction/exclusion gate runs before any provider call, so no
# suspected secret leaves the machine even when a key is configured.
if [ "${JEV_HOOK_OFF:-}" = "1" ]; then
  exit 0
fi
if command -v bun >/dev/null 2>&1 && [ -f agent-config/bin/review-check.ts ]; then
  base=$(git rev-parse --verify HEAD 2>/dev/null || printf '')
  [ -n "$base" ] || base=HEAD
  timeout 20 bun agent-config/bin/review-check.ts --staged --base "$base" --live || \
    printf 'jev review-check: advisory context only — never blocks; deterministic scanners above remain blocking\n'
fi
# Shared test-evidence advice reads the same immutable index snapshot. A provider
# outage is unavailable, never a passing verdict or a reason to waive scanners.
if command -v bun >/dev/null 2>&1 && [ -f agent-config/bin/semantic-check.ts ]; then
  bun agent-config/bin/semantic-check.ts --repo "$PWD" --staged || \
    printf 'semantic-check: advisory unavailable; deterministic scanners remain blocking\n'
fi
exit 0