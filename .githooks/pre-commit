#!/bin/sh
# Scan staged secrets.
set -eu
cd "$(git rev-parse --show-toplevel)"

# Step 1 (deterministic, blocking): scan EXACT staged content.
command -v gitleaks >/dev/null 2>&1 || {
  printf 'gitleaks is required for pre-commit secret scanning\n' >&2
  exit 1
}
gitleaks protect --staged --redact --no-banner || {
  printf 'gitleaks found a potential secret in staged content; commit refused\n' >&2
  exit 1
}
