#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { echo 'usage: t3-accounts/install-room-watch' >&2; exit 2; }
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
test -f "$HOME/.config/t3-accounts/room-watch.env" || {
  echo 'missing room-watch.env with T3_ACCOUNTS_ROOM_URL for the private evidence page' >&2
  exit 1
}
"$root/install"
mkdir -p "$HOME/.config/systemd/user"
install -m 644 "$root/room-watch.service" "$HOME/.config/systemd/user/t3-accounts-room-watch.service"
install -m 644 "$root/room-watch.timer" "$HOME/.config/systemd/user/t3-accounts-room-watch.timer"
systemctl --user daemon-reload
systemctl --user enable --now t3-accounts-room-watch.timer
