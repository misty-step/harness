            for a, r in (rep.get("accounts") or {}).items():
                entry = next(e for e in CONFIG["codex"] if e["account"] == a)
                if codex_retired(entry, h):
                    continue
                print(f"{'Codex ' + a:34}{r.get('live', '?'):20}{cfg['codex'].get(a, '')}")
