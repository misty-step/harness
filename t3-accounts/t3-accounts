def cmd_status():
    sync_helpers()
    statuses = all_statuses()
    rows = [(f"Claude {e['account']}", {h: e["instance"] for h in HOSTS}) for e in CONFIG["claude"]]
    rows += [(f"Codex {e['account']}", {h: instance_for(e, h) for h in HOSTS}) for e in CONFIG["codex"]]
    rows += [(w, {h: w for h in HOSTS}) for w in CONFIG["watch_only"]]
    print(f"{'ACCOUNT':34}" + "".join(f"{h:20}" for h in HOSTS))
    for label, insts in rows:
        cells = []
        for h in HOSTS:
            st = statuses.get(h, {}).get(insts[h])
            cells.append("unreachable" if h not in statuses else "ready" if ready(st) else (st or {}).get("auth", "missing"))
        print(f"{label:34}" + "".join(f"{c:20}" for c in cells))
    for h, cfg in PLAIN.items():
        if cfg.get("pull"):
            rep, error = read_pull_report(h)
