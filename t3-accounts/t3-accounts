                print(f"{'Codex ' + e['account']:34}{plain_codex_status(h, home):20}{home}")


def cmd_claude_renew(account):
    entry = next((e for e in CONFIG["claude"] if account in (e["account"], e["instance"])), None)
    if not entry:
        sys.exit(f"Unknown Claude account {account}")
    print(f"Sign in as {entry['account']} when the browser opens. Copy the token it prints at the end.")
    subprocess.run([str(HOME / ".local/bin/claude"), "setup-token"])
    import getpass
    token = getpass.getpass("Paste the token (hidden): ").strip()
    if not token.startswith("sk-ant-"):
        sys.exit("That does not look like a Claude token; nothing changed.")
    with tempfile.TemporaryDirectory(dir=HOME / ".cache/tmp") as cfg:
        p = subprocess.run([str(HOME / ".local/bin/claude"), "-p", "Reply with exactly: ok", "--model", "haiku", "--output-format", "json"],
                           env={"PATH": "/usr/bin:/bin", "HOME": str(HOME), "CLAUDE_CONFIG_DIR": cfg, "CLAUDE_CODE_OAUTH_TOKEN": token},
                           capture_output=True, text=True, timeout=120, cwd=cfg)
    try:
        assert json.loads(p.stdout).get("is_error") is False
    except Exception:
        sys.exit("Claude rejected that token; pass and T3 are unchanged.")
    print(f"Token works. Make sure the browser was signed in as {entry['account']}.")
    subprocess.run(["pass", "insert", "-m", "-f", entry["pass"]], input=token + "\n", text=True, check=True)
    cfg = json.loads((HOME / ".config/t3-accounts/accounts.json").read_text())
    for e in cfg["claude"]:
        if e["pass"] == entry["pass"]:
            e["issued"] = NOW.date().isoformat()
    (HOME / ".config/t3-accounts/accounts.json").write_text(json.dumps(cfg, indent=2) + "\n")
    CONFIG.update(cfg)
    cmd_sync()


# Owner keepalive: the owner's own Codex CLI refreshes itself via the documented app-server call
# getAuthStatus(refreshToken=true). `codex exec` alone does not refresh a token younger than ~8 days.
CODEX_KEEPALIVE = r"""
import json,os,sys,subprocess,select,time,datetime as dt
home=os.path.expanduser(sys.argv[1]); force=sys.argv[2]=="1"; min_days=float(sys.argv[3])
p=os.path.join(home,"auth.json")
def lr():
    try: return json.load(open(p)).get("last_refresh")
    except Exception: return None
def has_rt():
    try: return bool((json.load(open(p)).get("tokens") or {}).get("refresh_token"))
    except Exception: return False
before=lr()
if not has_rt(): print(json.dumps({"result":"not-owner","before":before})); sys.exit()
try: age=(dt.datetime.now(dt.timezone.utc)-dt.datetime.fromisoformat(before.replace("Z","+00:00")[:26]+"+00:00" if "." in before else before.replace("Z","+00:00"))).total_seconds()/86400
except Exception: age=999
if age<min_days and not force: print(json.dumps({"result":"fresh","before":before,"age_days":round(age,2)})); sys.exit()
codex=os.path.expanduser("~/.local/bin/codex")
if not os.path.exists(codex): codex="codex"
pr=subprocess.Popen([codex,"app-server"],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=dict(os.environ,CODEX_HOME=home),text=True,cwd=os.path.expanduser("~"))
def send(m): pr.stdin.write(json.dumps(m)+"\n"); pr.stdin.flush()
def wait(i,t=90):
    end=time.time()+t
    while time.time()<end:
        r,_,_=select.select([pr.stdout],[],[],1)
        if r:
            l=pr.stdout.readline()
            if not l: return None
            try: m=json.loads(l)
            except Exception: continue
            if m.get("id")==i: return m
    return None
err=None
send({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"t3-accounts-keepalive","version":"1"}}})
r=wait(1)
if not r or "error" in r: err="app-server initialize failed"
else:
    send({"jsonrpc":"2.0","method":"initialized"})
    send({"jsonrpc":"2.0","id":2,"method":"getAuthStatus","params":{"includeToken":False,"refreshToken":True}})
    r=wait(2)
    if not r or "error" in r: err="getAuthStatus failed"
    time.sleep(1)
pr.kill()
after=lr()
print(json.dumps({"result":"refreshed" if after and after!=before else "FAILED","before":before,"after":after,"age_days":round(age,2),"error":err}))
"""


def cmd_keepalive(force=False, only=None, min_days=3.0):
    """Refresh each Codex OWNER login (never readers) whose last_refresh is older than min_days, then sync."""
    failures = []
    for entry in CONFIG["codex"]:
        if only and only not in (entry["account"],):
            continue
        host, home = owner_of(entry)
        if instance_for(entry, host) in CONFIG["retired"]:
            continue
        before = py(host, CODEX_INFO, home)
        res = py(host, CODEX_KEEPALIVE, home, "1" if force else "0", str(min_days), timeout=210)
        after = py(host, CODEX_INFO, home)
        print(f"keepalive codex {entry['account']:24} {host}:{home}  {res.get('result', res.get('error'))}  "
              f"last_refresh {(before.get('last_refresh') or '-')[:19]} -> {(after.get('last_refresh') or '-')[:19]}  "
              f"expires {(before.get('access_exp') or '-')[:16]} -> {(after.get('access_exp') or '-')[:16]}")
        if res.get("result") not in ("refreshed", "fresh"):
            failures.append(f"Codex {entry['account']} owner {host}:{home} keepalive {res.get('result') or res.get('error')}")
    cmd_sync()
    if failures:
        msg = "**Accounts keepalive FAILED:**\n" + "\n".join(f"- {f}" for f in failures) + "\n"
        print(msg, file=sys.stderr)
        try:
            post_home(msg)
        except Exception as e:
            print(f"post_home failed: {e}", file=sys.stderr)
        return 1
    return 0


