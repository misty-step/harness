HOME = pathlib.Path.home()
CONFIG = json.loads((HOME / ".config/t3-accounts/accounts.json").read_text())
STATE_PATH = HOME / ".local/state/t3-accounts/state.json"
HELPER_SRC = HOME / ".local/share/t3-login/t3-login-helper.mjs"
HELPER = ".local/share/t3-login/t3-login-helper.mjs"
REMOTE_ENV = 'export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:$PATH"; cd ~;'
HOSTS = CONFIG["hosts"]
# Non-T3 hosts (e.g. hetzner-ci): fixed Codex homes, owner->reader push only, health from the Codex CLI itself.
PLAIN = CONFIG.get("plain_hosts", {})
NOW = dt.datetime.now(dt.timezone.utc)
CLAUDE_TOKEN_DAYS = 365      # `claude setup-token` lifetime
CLAUDE_WARN_DAYS = 30
READER_LAG_HOURS = 2
READER_EXPIRY_HOURS = 48


def sha(value: str) -> str:
    return hashlib.sha256(value.replace("\n", "").encode()).hexdigest()[:12]


DEAD = set()


def run(host, script, stdin=None, timeout=60):
    """Run a shell snippet on a host (locally for the empty destination). Returns (code, stdout).
    A host that times out or refuses SSH is skipped for the rest of this run."""
    if host in DEAD:
        return 255, ""
    dest = HOSTS[host] if host in HOSTS else PLAIN[host]["dest"]
    cmd = ["bash", "-c", REMOTE_ENV + script] if not dest else \
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2",
         "-o", "LogLevel=ERROR", dest, REMOTE_ENV + script]
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        DEAD.add(host)
        return 124, ""
    if dest and p.returncode == 255:
        DEAD.add(host)
    return p.returncode, p.stdout


def py(host, code, *args, stdin=None, timeout=60):
    """Run a Python snippet on a host with arguments; the snippet prints one JSON line."""
    script = "python3 -c " + shlex.quote(code) + " " + " ".join(shlex.quote(a) for a in args)
    rc, out = run(host, script, stdin=stdin, timeout=timeout)
    try:
        return json.loads(out.strip().splitlines()[-1])
    except Exception:
        return {"error": f"exit {rc}"}


def sync_helpers():
    for host, dest in HOSTS.items():
        if dest:
            run(host, f"mkdir -p ~/.local/share/t3-login && cat > ~/{HELPER}", stdin=HELPER_SRC.read_text())


def instance_for(entry, host):
    return entry["instances"].get(host, entry["instances"].get("*"))


def t3_status(host, ids):
    rc, out = run(host, f"bun {HELPER} status " + " ".join(shlex.quote(i) for i in ids))
    result = {}
    for line in out.splitlines():
        if "\t" in line:
            k, v = line.split("\t", 1)
            result[k] = json.loads(v)
    return result


def ready(st):
    return bool(st) and st.get("auth") == "authenticated" and st.get("status") != "error"


# --- remote snippets (run with python3 on the target host; print one JSON line, never a token) ---

SNIPPET_PRELUDE = r'''
import os
STATE=os.path.expanduser("~/.local/state/t3-accounts")
def side(kind,home,suffix=""):
    d=os.path.join(STATE,kind); os.makedirs(d,exist_ok=True)
    return os.path.join(d,os.path.realpath(home).strip("/").replace("/","%")+suffix)
def atomic_write(path,data):
    import json,tempfile
    tmpdir=os.path.join(STATE,"tmp"); os.makedirs(tmpdir,exist_ok=True)
    fd,tmp=tempfile.mkstemp(dir=tmpdir)
    with os.fdopen(fd,"w") as f: json.dump(data,f,indent=2)
    os.chmod(tmp,0o600)
    try: os.replace(tmp,path)
    except OSError:
        import shutil; shutil.copyfile(tmp,path+".partial"); os.chmod(path+".partial",0o600); os.replace(path+".partial",path); os.remove(tmp)
'''

CODEX_INFO = SNIPPET_PRELUDE + r'''
import json,os,sys,base64,datetime as dt
home=os.path.expanduser(sys.argv[1]); p=os.path.join(home,"auth.json")
if not os.path.exists(p): print(json.dumps({"present":False})); sys.exit()
d=json.load(open(p)); t=d.get("tokens") or {}
def claims(x):
    try: s=x.split(".")[1]; s+="="*(-len(s)%4); return json.loads(base64.urlsafe_b64decode(s))
    except Exception: return {}
a=claims(t.get("access_token","")); i=claims(t.get("id_token",""))
print(json.dumps({"present":True,"reader":os.path.exists(side("readers",home)),
 "has_refresh":bool(t.get("refresh_token")),"last_refresh":d.get("last_refresh"),
 "access_exp":dt.datetime.fromtimestamp(a.get("exp",0),dt.timezone.utc).isoformat() if a else None,
 "email":i.get("email"),"account_id":t.get("account_id"),
 "access_sha":__import__("hashlib").sha256(t.get("access_token","").encode()).hexdigest()[:12]}))
'''

# The owner's refresh token never leaves the owner host: it is blanked here before the payload is printed.
CODEX_READER_PAYLOAD = r'''
import json,os,sys
d=json.load(open(os.path.join(os.path.expanduser(sys.argv[1]),"auth.json")))
d.setdefault("tokens",{})["refresh_token"]=""
print(json.dumps({"payload":d}))
'''

# Never overwrites a home holding its own refresh token. The first takeover of a home keeps a backup.
CODEX_WRITE_READER = SNIPPET_PRELUDE + r'''
import json,os,sys,shutil,datetime as dt
home=os.path.expanduser(sys.argv[1]); label=sys.argv[2]
p=os.path.join(home,"auth.json"); marker=side("readers",home)
try:
    data=json.loads(sys.stdin.read())["payload"]
    assert data["tokens"]["access_token"] and data["tokens"]["refresh_token"]==""
except Exception:
    print(json.dumps({"result":"bad-payload"})); sys.exit()
os.makedirs(home,mode=0o700,exist_ok=True)
if os.path.exists(p):
    if (json.load(open(p)).get("tokens") or {}).get("refresh_token"):
        print(json.dumps({"result":"own-login"})); sys.exit()
    if not os.path.exists(marker):  # backups live in the state dir, never inside the home
        shutil.copy2(p,side("backups",home,".auth.json."+dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")))
atomic_write(p,data)
tmp=marker+".tmp"
with open(tmp,"w") as f: f.write(label+"\n")
os.chmod(tmp,0o600); os.replace(tmp,marker)
print(json.dumps({"result":"written"}))
'''


def parse_time(value):
    """Parse ISO times like 2026-10-21T14:38:09.415160669Z (nanoseconds allowed) as UTC."""
    if not value:
        return None
    t = dt.datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def age_days(value):
    t = parse_time(value)
    return (NOW - t).total_seconds() / 86400 if t else None


def pass_value(entry):
    p = subprocess.run(["pass", "show", entry], capture_output=True, text=True)
    return p.stdout.splitlines()[0].strip() if p.returncode == 0 and p.stdout else ""


# --- sync ---

def sync_claude(log, problems):
    for entry in CONFIG["claude"]:
        if entry["instance"] in CONFIG["retired"]:
            continue
        token = pass_value(entry["pass"])
        if not token:
            problems.append(("claude-pass:" + entry["account"], f"Claude {entry['account']}: no token in pass `{entry['pass']}`.", "high" if entry["keep"] else "low"))
            continue
        want = sha(token)
        # This server's pass feeds only this server's T3; other servers use their own credentials.
        for host in [h for h, dest in HOSTS.items() if not dest]:
            rc, out = run(host, f"bun {HELPER} envhash {shlex.quote(entry['instance'])} CLAUDE_CODE_OAUTH_TOKEN")
            have = out.strip()
            if rc != 0:
                log.append(f"{host}: unreachable for {entry['instance']}")
                continue
            if have == want:
                continue
            rc, out = run(host, f"bun {HELPER} setenv {shlex.quote(entry['instance'])} CLAUDE_CODE_OAUTH_TOKEN", stdin=token)
            outcome = out.strip().splitlines()[-1] if out.strip() else ""
            log.append(f"{host}: {entry['instance']} token from pass -> {outcome if outcome in ('stored', 'mismatch') else 'failed'}")


def owner_of(entry):
    host, home = entry["owner"].split(":", 1)
    return host, home


def codex_retired(entry, host):
    owner_host, _ = owner_of(entry)
    return any(instance_for(entry, h) in CONFIG["retired"] for h in (owner_host, host))


def is_owner_home(entry, host, home):
    owner_host, owner_home = owner_of(entry)
    return host == owner_host and home.rstrip("/").endswith(owner_home.lstrip("~").rstrip("/"))


def reader_label(owner_host, info):
    return f"T3 reader copy of {owner_host}, expires {(info.get('access_exp') or '?')[:16]}Z"


def sync_codex(log, problems, statuses, owners):
    """Copy each owner login to its readers. Never refreshes; the owner's own Codex CLI does that."""
    for entry in CONFIG["codex"]:
        owner_host, owner_home = owner_of(entry)
        if instance_for(entry, owner_host) in CONFIG["retired"]:
            continue
        info = py(owner_host, CODEX_INFO, owner_home)
        if info.get("error") or owner_host in DEAD:
            log.append(f"{owner_host}: could not read the Codex {entry['account']} owner login; readers not updated this run")
            continue
        if not info.get("present") or not info.get("has_refresh"):
            problems.append((f"codex-owner:{entry['account']}", f"Codex {entry['account']}: owner home {owner_host}:{owner_home} has {'no login' if not info.get('present') else 'no refresh token'}; readers cannot be kept fresh.", "high"))
            continue
        owners[entry["account"]] = dict(info, host=owner_host, home=owner_home)
        label = reader_label(owner_host, info)
        payload = None
        for host in HOSTS:
            inst = instance_for(entry, host)
            st = statuses.get(host, {}).get(inst)
            if inst in CONFIG["retired"] or host in DEAD or not st or not st.get("home"):
                continue
            home = st["home"]
            if is_owner_home(entry, host, home):
                continue
            here = py(host, CODEX_INFO, home)
            if here.get("error") or here.get("has_refresh"):
                continue  # unreadable, or this server's own separate login
            if here.get("access_sha") == info.get("access_sha") and here.get("last_refresh") == info.get("last_refresh") and st.get("reader") == label:
                continue
            if payload is None:
                snap = py(owner_host, CODEX_READER_PAYLOAD, owner_home)
                tokens = (snap.get("payload") or {}).get("tokens") or {}
                if not tokens.get("access_token") or tokens.get("refresh_token") != "":
                    log.append(f"{owner_host}: Codex {entry['account']} owner snapshot unusable; readers not updated this run")
                    break
                payload = json.dumps(snap)
            res = py(host, CODEX_WRITE_READER, home, label, stdin=payload)
            log.append(f"{host}: Codex {entry['account']} reader {inst} ({home}) <- {owner_host} -> {res.get('result')}")
        for host, cfg in PLAIN.items():
            home = cfg.get("codex", {}).get(entry["account"])
            if not home or host in DEAD or cfg.get("pull") or codex_retired(entry, host):
                continue
            here = py(host, CODEX_INFO, home)
            if here.get("error") or here.get("has_refresh"):
                continue  # unreachable, or this host's own separate login
            if here.get("access_sha") == info.get("access_sha") and here.get("last_refresh") == info.get("last_refresh") and here.get("reader"):
                continue
            if payload is None:
                snap = py(owner_host, CODEX_READER_PAYLOAD, owner_home)
                tokens = (snap.get("payload") or {}).get("tokens") or {}
                if not tokens.get("access_token") or tokens.get("refresh_token") != "":
                    log.append(f"{owner_host}: Codex {entry['account']} owner snapshot unusable; readers not updated this run")
                    continue
                payload = json.dumps(snap)
            res = py(host, CODEX_WRITE_READER, home, label, stdin=payload)
            log.append(f"{host}: Codex {entry['account']} reader (plain host, {home}) <- {owner_host} -> {res.get('result')}")


# --- checks ---

def check(statuses, problems, state, owners, table):
    for entry in CONFIG["claude"]:
        if entry["instance"] in CONFIG["retired"]:
            continue
        expires = dt.datetime.fromisoformat(entry["issued"]).replace(tzinfo=dt.timezone.utc) + dt.timedelta(days=CLAUDE_TOKEN_DAYS)
        left = (expires - NOW).days
        if left <= CLAUDE_WARN_DAYS:
            problems.append((f"claude-expiry:{entry['account']}", f"Claude {entry['account']}: token expires {expires:%Y-%m-%d} ({left} days). Renew once with `t3-accounts claude-renew {entry['account']}`.", "high" if entry["keep"] else "low"))
    for entry in CONFIG["codex"]:
        for host in HOSTS:
            inst = instance_for(entry, host)
            st = statuses.get(host, {}).get(inst)
            if inst in CONFIG["retired"]:
                continue
            # A reader that cannot be inspected stays a visible problem; it must never read as resolved.
            if not st or not st.get("home"):
                if host in statuses:
                    problems.append((f"codex-unverified:{host}:{inst}", f"Codex {entry['account']} on {host} ({inst}): T3 reports no login home, so its token expiry cannot be read.", "high" if entry["keep"] else "low"))
                continue
            info = py(host, CODEX_INFO, st["home"])
            if info.get("error"):
                problems.append((f"codex-unverified:{host}:{inst}", f"Codex {entry['account']} on {host} ({inst}): could not read {st['home']} ({info['error']}).", "high" if entry["keep"] else "low"))
                continue
            if not info.get("present"):
                problems.append((f"codex-unverified:{host}:{inst}", f"Codex {entry['account']} on {host} ({inst}): no auth.json in {st['home']}.", "high" if entry["keep"] else "low"))
                continue
            # A login without a refresh token is a reader copy: it lives only as long as its owner keeps refreshing.
            role = "owner" if is_owner_home(entry, host, st["home"]) else "own login" if info.get("has_refresh") else "reader"
            table.append((entry["account"], host, inst, st["home"], role, info.get("last_refresh"), info.get("access_exp"), st.get("t3Managed")))
            if role == "owner" and info.get("access_exp"):
                hours = (parse_time(info["access_exp"]) - NOW).total_seconds() / 3600
                if hours < READER_EXPIRY_HOURS:
                    problems.append((f"codex-owner-expiry:{entry['account']}", f"Codex {entry['account']} owner on {host} ({inst}): access token expires in {hours:.0f}h ({info['access_exp'][:16]}Z). Use its Codex CLI so it refreshes.", "high"))
            if role != "reader":
                continue
            owner = owners.get(entry["account"])
            lag = (parse_time(owner["last_refresh"]) - parse_time(info["last_refresh"])).total_seconds() / 3600 \
                if owner and owner.get("last_refresh") and info.get("last_refresh") else None
            if lag is not None and lag > READER_LAG_HOURS:
                problems.append((f"codex-reader-lag:{host}:{inst}", f"Codex {entry['account']} reader on {host} ({inst}) lags its owner {owner['host']} by {lag:.1f}h after the push.", "high"))
            if info.get("access_exp"):
                hours = (parse_time(info["access_exp"]) - NOW).total_seconds() / 3600
                if hours < READER_EXPIRY_HOURS:
                    problems.append((f"codex-reader-expiry:{host}:{inst}", f"Codex {entry['account']} reader on {host} ({inst}): access token expires in {hours:.0f}h ({info['access_exp'][:16]}Z). The owner {entry['owner']} must refresh (use its Codex CLI).", "high"))
    check_plain(problems, owners, table)
    tracked = {e["instance"]: e for e in CONFIG["claude"]}
    tracked.update({instance_for(e, h): e for e in CONFIG["codex"] for h in HOSTS})
    was_ready = set(state.get("ready", []))
    now_ready = set()
    for host, insts in statuses.items():
        for inst, st in insts.items():
            if inst in CONFIG["retired"]:
                continue
            key = f"{host}:{inst}"
            if ready(st):
                now_ready.add(key)
                continue
            entry = tracked.get(inst)
            if entry is not None or key in was_ready:
                keep = entry["keep"] if entry else False
                problems.append((f"health:{key}", f"{host} · {inst}: {st.get('message') or st.get('auth')}", "high" if keep else "low"))
    state["ready"] = sorted(now_ready | {k for k in was_ready if k.split(':', 1)[0] not in statuses})


def plain_codex_status(host, home):
    """Health of a Codex home on a non-T3 host, straight from the Codex CLI."""
    if home == "~":
        quoted_home = '"$HOME"'
    elif home.startswith("~/"):
        quoted_home = '"$HOME"/' + shlex.quote(home[2:])
    else:
        quoted_home = shlex.quote(home)
    rc, out = run(host, f"set -o pipefail; CODEX_HOME={quoted_home} timeout 30 codex login status 2>&1 | tail -1")
    if rc == 255 or host in DEAD:
        return "unreachable"
    if rc == 124:
        return "timeout"
    return "ready" if "Logged in" in out else "unauthenticated"


PULL_DIR = HOME / ".local/state/t3-accounts/pull"
PULL_STALE_HOURS = 3


def pull_report_path(host):
    if host not in PLAIN or PLAIN[host].get("pull") is not True or pathlib.Path(host).name != host:
        raise ValueError("invalid pull host")
    path = PULL_DIR / f"{host}.json"
    if path.resolve().parent != PULL_DIR.resolve():
        raise ValueError("invalid pull report path")
    return path


def validate_pull_report(host, rep):
    if not isinstance(rep, dict) or not isinstance(rep.get("accounts"), dict):
        raise ValueError("invalid pull report accounts")
    configured = set(PLAIN[host].get("codex", {})) & {e["account"] for e in CONFIG["codex"]}
    for account, row in rep["accounts"].items():
        if account not in configured or not isinstance(row, dict):
            raise ValueError("invalid pull report account")
        if row.get("live") not in ("ready", "unauthenticated", "missing") or type(row.get("has_refresh")) is not bool:
            raise ValueError("invalid pull report health")
        for field in ("access_exp", "last_refresh"):
            value = row.get(field)
            if value is not None and (not isinstance(value, str) or not value.strip() or parse_time(value) is None):
                raise ValueError("invalid pull report timestamp")


def read_pull_report(host):
    try:
        path = pull_report_path(host)
        rep = json.loads(path.read_text())
        validate_pull_report(host, rep)
        if not isinstance(rep.get("at"), str) or parse_time(rep["at"]) is None:
            raise ValueError("invalid receipt time")
        return rep, None
    except FileNotFoundError:
        return {}, None
    except (OSError, ValueError, TypeError):
        return {}, "invalid or unreadable report"


def check_pull(host, cfg, problems, owners, table):
    """Pull hosts (no inbound SSH, e.g. the grok box) report via `t3-accounts pull-report`; read that here."""
    rep, error = read_pull_report(host)
    age = (NOW - parse_time(rep["at"])).total_seconds() / 3600 if rep.get("at") else None
    for entry in CONFIG["codex"]:
        home = cfg.get("codex", {}).get(entry["account"])
        if not home or codex_retired(entry, host):
            continue
        key = f"codex-plain:{host}:{entry['account']}"
        sev = "high" if entry["keep"] else "low"
        r = (rep.get("accounts") or {}).get(entry["account"])
        if error:
            problems.append((key, f"Codex {entry['account']} on {host} (pull host): {error}; run its t3-reader-pull.", sev))
            continue
        if age is None or age > PULL_STALE_HOURS:
            problems.append((key, f"Codex {entry['account']} on {host} (pull host): no fresh report ({'never' if age is None else f'{age:.1f}h old'}); run its t3-reader-pull.", sev))
            continue
        if not r:
            problems.append((key, f"Codex {entry['account']} on {host} (pull host): account not present in report; run its t3-reader-pull.", sev))
            continue
        if r.get("live") != "ready":
            problems.append((key, f"Codex {entry['account']} on {host} (pull host): codex login status says {r.get('live')}.", sev))
        role = "own login" if r["has_refresh"] else "reader"
        table.append((entry["account"], host, "-", home, role, r.get("last_refresh"), r.get("access_exp"), False))
        if role != "reader":
            continue
        if r.get("access_exp") and (parse_time(r["access_exp"]) - NOW).total_seconds() / 3600 < READER_EXPIRY_HOURS:
            problems.append((f"codex-reader-expiry:{host}:{entry['account']}", f"Codex {entry['account']} reader on {host}: access token expires soon. The owner {entry['owner']} must refresh.", "high"))
        elif r.get("live") == "ready" and not r.get("access_exp"):
            problems.append((f"codex-reader-expiry:{host}:{entry['account']}", f"Codex {entry['account']} reader on {host}: access token expiry is unknown.", "low"))


def cmd_reader_payload(account):
    """Print the owner's auth.json with refresh_token blanked (for pull hosts). Never prints a refresh token."""
    entry = next((e for e in CONFIG["codex"] if e["account"] == account), None)
    if entry is None:
        sys.exit(f"Unknown Codex account {account}")
    owner_host, owner_home = owner_of(entry)
    snap = py(owner_host, CODEX_READER_PAYLOAD, owner_home)
    tokens = (snap.get("payload") or {}).get("tokens") or {}
    if not tokens.get("access_token") or tokens.get("refresh_token") != "":
        sys.exit("owner snapshot unusable")
    snap["label"] = reader_label(owner_host, py(owner_host, CODEX_INFO, owner_home))
    print(json.dumps(snap))


def cmd_pull_report(host):
    try:
        path = pull_report_path(host)
        rep = json.loads(sys.stdin.read())
        validate_pull_report(host, rep)
    except (OSError, ValueError, TypeError):
        sys.exit("t3-accounts: invalid pull host or report; nothing stored")
    rep["at"] = NOW.isoformat()
    PULL_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=PULL_DIR)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(rep, stream, indent=1)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("recorded")


def check_plain(problems, owners, table):
    for host, cfg in PLAIN.items():
        if cfg.get("pull"):
            check_pull(host, cfg, problems, owners, table)
            continue
        for entry in CONFIG["codex"]:
            home = cfg.get("codex", {}).get(entry["account"])
            if not home or codex_retired(entry, host):
                continue
            sev = "high" if entry["keep"] else "low"
            key = f"codex-plain:{host}:{entry['account']}"
            info = py(host, CODEX_INFO, home)
            if host in DEAD or info.get("error"):
                problems.append((key, f"Codex {entry['account']} on {host} (plain host): unreachable.", sev))
                continue
            if not info.get("present"):
                problems.append((key, f"Codex {entry['account']} on {host} (plain host): no auth.json in {home}.", sev))
                continue
            live = plain_codex_status(host, home)
            if live != "ready":
                problems.append((key, f"Codex {entry['account']} on {host} (plain host): codex login status says {live}.", sev))
            role = "own login" if info.get("has_refresh") else "reader"
            table.append((entry["account"], host, "-", home, role, info.get("last_refresh"), info.get("access_exp"), False))
            if role != "reader":
                continue
            owner = owners.get(entry["account"])
            if owner and owner.get("last_refresh") and info.get("last_refresh"):
                lag = (parse_time(owner["last_refresh"]) - parse_time(info["last_refresh"])).total_seconds() / 3600
                if lag > READER_LAG_HOURS:
                    problems.append((f"codex-reader-lag:{host}:{entry['account']}", f"Codex {entry['account']} reader on {host} lags its owner {owner['host']} by {lag:.1f}h after the push.", "high"))
            if info.get("access_exp"):
                hours = (parse_time(info["access_exp"]) - NOW).total_seconds() / 3600
                if hours < READER_EXPIRY_HOURS:
                    problems.append((f"codex-reader-expiry:{host}:{entry['account']}", f"Codex {entry['account']} reader on {host}: access token expires in {hours:.0f}h. The owner {entry['owner']} must refresh (use its Codex CLI).", "high"))


def all_statuses():
    statuses = {}
    for host in HOSTS:
        ids = [e["instance"] for e in CONFIG["claude"]]
        ids += [instance_for(e, host) for e in CONFIG["codex"]]
        ids += CONFIG["watch_only"]
        got = t3_status(host, ids)
        if got:
            statuses[host] = got
    return statuses


def post_home(body):
    subprocess.run(["home", "post", "--from", "Accounts"], input=body, text=True, timeout=60)


def cmd_watch(post=True):
    state = json.loads(STATE_PATH.read_text()) if STATE_PATH.exists() else {}
    log, problems = [], []
    sync_helpers()
    statuses = all_statuses()
    sync_claude(log, problems)
    owners, table = {}, []
    sync_codex(log, problems, statuses, owners)
    if log:
        statuses = all_statuses()
    check(statuses, problems, state, owners, table)
    open_now = {k: (msg, sev) for k, msg, sev in problems}
    before = {k: v for k, v in state.get("open", {}).items() if not k.startswith("claude-live:")}
    unreachable = [h for h in HOSTS if h not in statuses]
    misses = state.setdefault("unreachable_runs", {})
    for h in HOSTS:
        misses[h] = misses.get(h, 0) + 1 if h in unreachable else 0
        if misses[h] >= 6:
            open_now[f"unreachable:{h}"] = (f"{h}: T3 or SSH has been unreachable for {misses[h]} hourly checks; its accounts are unverified.", "high")
    new = {k: v for k, v in open_now.items() if k not in before}
    resolved = [k for k in before if k not in open_now]
    for line in log:
        print(line)
    for account, host, inst, home, role, last, exp, managed in table:
        print(f"codex {account:24} {host:18} {inst:17} {role:9} last_refresh {(last or '-')[:16]}  expires {(exp or '-')[:16]}  {home}{' (T3 shadow)' if managed else ''}")
    for k, (msg, sev) in open_now.items():
        print(f"[{sev}] {msg}")
    if unreachable:
        print("unreachable: " + ", ".join(unreachable))
    if post and (new or resolved):
        lines = []
        if new:
            lines.append("Accounts watcher found " + ("a problem" if len(new) == 1 else f"{len(new)} problems") + ":")
            lines += [f"- {'**' if sev == 'high' else ''}{msg}{'**' if sev == 'high' else ''}" for msg, sev in new.values()]
        if resolved:
            lines.append(("Resolved: " if new else "Accounts watcher: resolved: ") + "; ".join(before[k][0] for k in resolved))
        lines += [f"- Codex {a} {h} ({i}) {r}: expires {(e or '?')[:16]}Z" for a, h, i, _, r, _, e, _ in table if r == "reader"]
        lines.append("Table: https://mirrodin.tail5f5eb4.ts.net/accounts-t3-logins/")
        post_home("\n".join(lines) + "\n")
    state["open"] = open_now
    state["checked_at"] = NOW.isoformat()
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=1))
    return 0 if not open_now else 1


def cmd_sync():
    log, problems = [], []
