#!/bin/sh
# Deploy owned pi configuration into the pi coding-agent directory.
#
# Source of truth for this machine's pi preferences: settings, global session
# guidance (AGENTS.md), the custom composer chrome, the LOC status extension,
# the Exa web-search extension, the model-failover extension, and the
# authenticated-commands skill. Preflight validates every selected input
# before any write. Pokayoke: unknown components, empty sources, and invalid
# settings fail closed before mutation; owned packages are clean-replaced so
# obsolete files cannot survive; foreign live keys and unmanaged agent files
# are never overwritten.
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}

require_bun() {
  command -v bun >/dev/null 2>&1 || { echo "bun is required" >&2; exit 1; }
}

require_nonempty() {
  [ -s "$1" ] || {
    printf 'Missing or empty source: %s\n' "$1" >&2
    exit 1
  }
}

selected=${PI_CONFIG_COMPONENTS:-all}
case "$selected" in
  all) components="config guidance pi-chrome loc web-search failover skills" ;;
  "") components="" ;;
  *) components="$selected" ;;
esac

for component in $components; do
  case "$component" in
    config|guidance|pi-chrome|loc|web-search|failover|skills) ;;
    *) printf 'Unknown component: %s\n' "$component" >&2; exit 1 ;;
  esac
done

has() {
  case " $components " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_config() {
  require_bun
  require_nonempty "$repo_dir/settings.json"
  bun "$repo_dir/bin/pi-merge-settings.ts" \
    --source "$repo_dir/settings.json" \
    --dest "$agent_dir/settings.json" \
    --check
}

install_config() {
  install -d -m 700 "$agent_dir"
  bun "$repo_dir/bin/pi-merge-settings.ts" \
    --source "$repo_dir/settings.json" \
    --dest "$agent_dir/settings.json"
}

validate_guidance() {
  require_nonempty "$repo_dir/global/AGENTS.md"
}

install_guidance() {
  install -d -m 700 "$agent_dir"
  install -m 600 "$repo_dir/global/AGENTS.md" "$agent_dir/AGENTS.md"
}

validate_pi_chrome() {
  require_nonempty "$repo_dir/extensions/pi-chrome.ts"
}

install_pi_chrome() {
  install -d -m 700 "$agent_dir/extensions"
  install -m 600 "$repo_dir/extensions/pi-chrome.ts" "$agent_dir/extensions/pi-chrome.ts"
}

validate_loc() {
  for file in analyze.ts index.ts git-hook.sh; do
    require_nonempty "$repo_dir/extensions/loc/$file"
  done
}

install_loc() {
  # Pokayoke: clean-replace the owned package so obsolete files cannot survive.
  rm -rf "$agent_dir/extensions/loc"
  install -d -m 700 "$agent_dir/extensions/loc"
  for file in analyze.ts index.ts loc.test.ts; do
    install -m 600 "$repo_dir/extensions/loc/$file" "$agent_dir/extensions/loc/$file"
  done
  install -m 700 "$repo_dir/extensions/loc/git-hook.sh" "$agent_dir/extensions/loc/git-hook.sh"
}

install_git_hook() {
  [ -d "$repo_dir/.git" ] || return 0
  install -m 700 "$repo_dir/.githooks/pre-push" "$repo_dir/.git/hooks/pre-push"
}

validate_web_search() {
  for file in index.ts format.ts web-search.test.ts; do
    require_nonempty "$repo_dir/extensions/web-search/$file"
  done
}

install_web_search() {
  # Pokayoke: clean-replace the owned package so obsolete files cannot survive.
  rm -rf "$agent_dir/extensions/web-search"
  install -d -m 700 "$agent_dir/extensions/web-search"
  for file in index.ts format.ts web-search.test.ts; do
    install -m 600 "$repo_dir/extensions/web-search/$file" "$agent_dir/extensions/web-search/$file"
  done
}

validate_failover() {
  for file in index.ts decide.ts decide.test.ts; do
    require_nonempty "$repo_dir/extensions/failover/$file"
  done
}

install_failover() {
  # Pokayoke: clean-replace the owned package so obsolete files cannot survive.
  rm -rf "$agent_dir/extensions/failover"
  install -d -m 700 "$agent_dir/extensions/failover"
  for file in index.ts decide.ts decide.test.ts; do
    install -m 600 "$repo_dir/extensions/failover/$file" "$agent_dir/extensions/failover/$file"
  done
}

validate_skills() {
  for skill_dir in "$repo_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    require_nonempty "$skill_dir/SKILL.md"
  done
}

install_skills() {
  # Clean-replace owned skills so obsolete files cannot survive.
  # Omarchy skill symlinks live in this same parent and are foreign.
  for skill_dir in "$repo_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    skill_name=${skill_dir##*/}
    rm -rf "$agent_dir/skills/$skill_name"
    install -d -m 700 "$agent_dir/skills/$skill_name"
    install -m 600 "$skill_dir/SKILL.md" "$agent_dir/skills/$skill_name/SKILL.md"
  done
}

if has config; then validate_config; fi
if has guidance; then validate_guidance; fi
if has pi-chrome; then validate_pi_chrome; fi
if has loc; then validate_loc; fi
if has web-search; then validate_web_search; fi
if has failover; then validate_failover; fi
if has skills; then validate_skills; fi

if has config; then install_config; fi
if has guidance; then install_guidance; fi
if has pi-chrome; then install_pi_chrome; fi
if has loc; then install_loc; fi
if has web-search; then install_web_search; fi
if has failover; then install_failover; fi
if has skills; then install_skills; fi
install_git_hook
