#!/bin/sh
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$(omp config path)}
development_root=${OMP_DEVELOPMENT_ROOT:-$HOME/development}

require_bun() {
  command -v bun >/dev/null 2>&1 || { echo "bun is required" >&2; exit 1; }
}

require_jq() {
  command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }
}

require_nonempty() {
  [ -s "$1" ] || {
    printf 'Missing or empty source: %s\n' "$1" >&2
    exit 1
  }
}

guidance_files='AGENTS.md WATCHDOG.md WATCHDOG.yml'

validate_guidance() {
  for file in $guidance_files; do
    require_nonempty "$repo_dir/global/$file"
  done
}

install_guidance() {
  install -d -m 700 "$agent_dir"
  for file in $guidance_files; do
    install -m 600 "$repo_dir/global/$file" "$agent_dir/$file"
  done
  rm -f -- "$agent_dir/RULES.md"
}

validate_config() {
  require_bun
  require_nonempty "$repo_dir/config.yml"
  require_nonempty "$repo_dir/models.yml"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/config.yml" --dest "$agent_dir/config.yml" --check
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/models.yml" --dest "$agent_dir/models.yml" --check
}

install_config() {
  install -d -m 700 "$agent_dir"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/config.yml" --dest "$agent_dir/config.yml"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/models.yml" --dest "$agent_dir/models.yml"
}

validate_mcp() {
  require_jq
  require_nonempty "$repo_dir/mcp.json"
  jq empty "$repo_dir/mcp.json" >/dev/null
  if [ -f "$agent_dir/mcp.json" ]; then
    jq empty "$agent_dir/mcp.json" >/dev/null
  fi
}

install_mcp() {
  install -d -m 700 "$agent_dir"
  mcp_target="$agent_dir/mcp.json"
  if [ -f "$mcp_target" ]; then
    temp=$(mktemp "$agent_dir/.mcp.json.XXXXXX")
    trap 'rm -f "$temp"' 0 1 2 15
    jq -s '
      .[0] as $policy
      | .[1] as $live
      | $policy
      | .mcpServers = (
          $policy.mcpServers
          | with_entries(
              . as $server
              | .value += (
                  ($live.mcpServers[$server.key] // {})
                  | {auth, oauth}
                  | with_entries(select(.value != null))
                )
            )
        )
    ' "$repo_dir/mcp.json" "$mcp_target" > "$temp"
    chmod 600 "$temp"
    mv "$temp" "$mcp_target"
    trap - 0 1 2 15
  else
    install -m 600 "$repo_dir/mcp.json" "$mcp_target"
  fi
}

validate_scopes() {
  require_bun
  require_nonempty "$repo_dir/workspace-mcp.json"
  require_nonempty "$repo_dir/bin/omp-install-scopes.ts"
  bun "$repo_dir/bin/omp-install-scopes.ts" \
    --agent-dir "$agent_dir" \
    --development-root "$development_root" \
    --check
}

install_scopes() {
  bun "$repo_dir/bin/omp-install-scopes.ts" \
    --agent-dir "$agent_dir" \
    --development-root "$development_root"
}


validate_skill() {
  skill=$1
  case $skill in
    ''|*[!a-zA-Z0-9_-]*)
      printf 'Invalid skill name: %s\n' "$skill" >&2
      exit 1
      ;;
  esac
  require_nonempty "$repo_dir/skills/$skill/SKILL.md"
}

install_skill() {
  skill=$1
  install -d -m 700 "$agent_dir/skills"
  skill_temp=$(mktemp -d "$agent_dir/.skill.XXXXXX")
  trap 'rm -rf "$skill_temp"' 0 1 2 15
  cp -R "$repo_dir/skills/$skill"/. "$skill_temp"/
  chmod -R u=rwX,go= "$skill_temp"
  rm -rf -- "$agent_dir/skills/$skill"
  mv "$skill_temp" "$agent_dir/skills/$skill"
  trap - 0 1 2 15
}

validate_owned_skills() {
  found=
  for skill_dir in "$repo_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    found=1
    require_nonempty "$skill_dir/SKILL.md"
  done
  [ -n "$found" ] || { echo "Missing source skills" >&2; exit 1; }
}

install_owned_skills() {
  for skill_dir in "$repo_dir"/skills/*; do
    [ -d "$skill_dir" ] || continue
    install_skill "${skill_dir##*/}"
  done
}

validate_agents() {
  found=
  for agent_file in "$repo_dir"/agents/*.md; do
    [ -s "$agent_file" ] || continue
    found=1
    require_nonempty "$agent_file"
  done
  [ -n "$found" ] || { echo "Missing source agents" >&2; exit 1; }
}

install_agents() {
  install -d -m 700 "$agent_dir/agents"
  for agent_file in "$repo_dir"/agents/*.md; do
    [ -s "$agent_file" ] || continue
    install -m 600 "$agent_file" "$agent_dir/agents/${agent_file##*/}"
  done
}

validate_executive() {
  require_bun
  require_nonempty "$repo_dir/extensions/executive/index.ts"
  require_nonempty "$repo_dir/agents/executive.md"
  require_nonempty "$repo_dir/config.yml"
  require_nonempty "$repo_dir/bin/omp-merge-config.ts"
  bun "$repo_dir/bin/omp-merge-config.ts" \
    --source "$repo_dir/config.yml" --dest "$agent_dir/config.yml" \
    --key task.maxRecursionDepth --check
  OMP_EXECUTIVE_SOURCE="$repo_dir" OMP_EXECUTIVE_DEST="$agent_dir" bun -e '
    import { lstat, readdir, readFile } from "node:fs/promises";
    import { dirname, extname, join, resolve, sep } from "node:path";
    const source = process.env.OMP_EXECUTIVE_SOURCE;
    const target = process.env.OMP_EXECUTIVE_DEST;
    const extension = resolve(source, "extensions/executive");
    const files = new Set();
    async function collect(directory) {
      const info = await lstat(directory);
      if (!info.isDirectory() || info.isSymbolicLink()) throw new Error(`Expected an ordinary package directory: ${directory}`);
      for (const entry of await readdir(directory, { withFileTypes: true })) {
        const path = join(directory, entry.name);
        if (entry.isDirectory()) await collect(path);
        else if (entry.isFile()) files.add(path);
        else throw new Error(`Refusing non-file package entry: ${path}`);
      }
    }
    await collect(extension);
    const transpilers = {
      ".ts": new Bun.Transpiler({ loader: "ts" }),
      ".tsx": new Bun.Transpiler({ loader: "tsx" }),
      ".js": new Bun.Transpiler({ loader: "js" }),
      ".jsx": new Bun.Transpiler({ loader: "jsx" }),
    };
    for (const path of files) {
      const suffix = extname(path);
      if (suffix === ".json") JSON.parse(await readFile(path, "utf8"));
      const transpiler = transpilers[suffix] ?? (suffix === ".mjs" || suffix === ".cjs" ? transpilers[".js"] : undefined);
      if (!transpiler) continue;
      const text = await readFile(path, "utf8");
      const scanned = transpiler.scan(text);
      if (path === join(extension, "index.ts") && !scanned.exports.includes("default")) {
        throw new Error(`Missing executive extension default export: ${path}`);
      }
      for (const imported of scanned.imports) {
        if (!imported.path.startsWith(".") && !imported.path.startsWith("/")) continue;
        const local = resolve(dirname(path), imported.path);
        if (!local.startsWith(`${extension}${sep}`)) throw new Error(`Package import leaves executive: ${imported.path}`);
        const candidates = [
          local,
          ...[".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".json"].map(suffix => `${local}${suffix}`),
          ...["index.ts", "index.tsx", "index.js", "index.mjs", "index.cjs"].map(name => join(local, name)),
        ];
        if (local.endsWith(".js")) candidates.push(`${local.slice(0, -3)}.ts`, `${local.slice(0, -3)}.tsx`);
        if (!candidates.some(candidate => files.has(candidate))) throw new Error(`Missing package import: ${imported.path} from ${path}`);
      }
    }
    const agentPath = join(source, "agents/executive.md");
    const agentInfo = await lstat(agentPath);
    if (!agentInfo.isFile() || agentInfo.isSymbolicLink()) throw new Error(`Expected an ordinary agent file: ${agentPath}`);
    const agentText = await readFile(agentPath, "utf8");
    const frontmatter = /^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]+)$/.exec(agentText);
    if (!frontmatter || !frontmatter[2].trim()) throw new Error(`Missing agent frontmatter or instructions: ${agentPath}`);
    const agent = Bun.YAML.parse(frontmatter[1]);
    if (!agent || agent.name !== "executive" || typeof agent.description !== "string" || !agent.description.trim()) {
      throw new Error(`Invalid executive agent definition: ${agentPath}`);
    }
    for (const field of ["tools", "spawns"]) {
      const entries = typeof agent[field] === "string" ? agent[field].split(",").map(value => value.trim()) : agent[field];
      if (!Array.isArray(entries) || !entries.length || entries.some(value => typeof value !== "string" || !value.trim())) {
        throw new Error(`Invalid executive ${field}: ${agentPath}`);
      }
    }
    for (const path of [target, join(target, "extensions"), join(target, "agents"), join(target, "extensions/executive"), join(target, "agents/executive.md")]) {
      try {
        const info = await lstat(path);
        const valid = path === join(target, "agents/executive.md") ? info.isFile() : info.isDirectory();
        if (!valid || info.isSymbolicLink()) throw new Error(`Refusing invalid or symlinked executive destination: ${path}`);
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
      }
    }
  '
}

install_executive_extension() {
  install -d -m 700 "$agent_dir/extensions"
  executive_temp=$(mktemp -d "$agent_dir/.executive.XXXXXX")
  trap 'rm -rf "$executive_temp"' 0 1 2 15
  cp -R "$repo_dir/extensions/executive"/. "$executive_temp"/
  chmod -R u=rwX,go= "$executive_temp"
  rm -rf -- "$agent_dir/extensions/executive"
  mv "$executive_temp" "$agent_dir/extensions/executive"
  trap - 0 1 2 15
}

install_executive() {
  install_executive_extension
  install -d -m 700 "$agent_dir/agents"
  install -m 600 "$repo_dir/agents/executive.md" "$agent_dir/agents/executive.md"
  bun "$repo_dir/bin/omp-merge-config.ts" \
    --source "$repo_dir/config.yml" --dest "$agent_dir/config.yml" \
    --key task.maxRecursionDepth
}

validate_themes() {
  require_jq
  found=
  for theme_file in "$repo_dir"/themes/*.json; do
    [ -s "$theme_file" ] || continue
    found=1
    jq empty "$theme_file" >/dev/null
  done
  [ -n "$found" ] || { echo "Missing source themes" >&2; exit 1; }
}

install_themes() {
  install -d -m 700 "$agent_dir/themes"
  rm -f -- "$agent_dir/themes/ember.json" "$agent_dir/themes/ember-dawn.json"
  for theme_file in "$repo_dir"/themes/*.json; do
    [ -s "$theme_file" ] || continue
    install -m 600 "$theme_file" "$agent_dir/themes/${theme_file##*/}"
  done
}

install_extensions() {
  rm -f "$agent_dir/extensions/evidence-packet.ts"
  rm -rf -- "$agent_dir/references/review"
  for ext_dir in "$repo_dir"/extensions/*; do
    [ -d "$ext_dir" ] || continue
    [ "${ext_dir##*/}" != executive ] || continue
    ext_name=${ext_dir##*/}
    install -d -m 700 "$agent_dir/extensions/$ext_name"
    for ext_entry in "$ext_dir"/*; do
      [ -f "$ext_entry" ] || continue
      install -m 700 "$ext_entry" "$agent_dir/extensions/$ext_name/${ext_entry##*/}"
    done
  done
  loc_hook="$repo_dir/extensions/loc/git-hook.sh"
  if [ -x "$loc_hook" ]; then
    git_dir=$(git -C "$repo_dir" rev-parse --absolute-git-dir 2>/dev/null) || git_dir=
    if [ -n "$git_dir" ]; then
      install -d "$git_dir/hooks"
      for hook_name in post-commit post-merge post-checkout; do
        target="$git_dir/hooks/$hook_name"
        if [ ! -e "$target" ]; then
          ln -sf "../../extensions/loc/git-hook.sh" "$target" 2>/dev/null || install -m 700 "$loc_hook" "$target"
        fi
      done
    fi
  fi
}

install_hooks() {
  hook_src="$repo_dir/.githooks/pre-push"
  if [ -s "$hook_src" ]; then
    git_dir=$(git -C "$repo_dir" rev-parse --absolute-git-dir 2>/dev/null) || git_dir=
    if [ -n "$git_dir" ]; then
      install -d "$git_dir/hooks"
      install -m 700 "$hook_src" "$git_dir/hooks/pre-push"
    fi
  fi
}

install_cli() {
  require_nonempty "$repo_dir/bin/omp-grievances.ts"
  install -d -m 700 "$HOME/.local/bin"
  install -m 700 "$repo_dir/bin/omp-grievances.ts" "$HOME/.local/bin/omp-grievances"
}

# Exact last shipped launcher: never remove an unrelated executable with this name.
retired_secrets_sha256=1caedcbb2d86624df3beaf7e67a5563ea641b8245c16d787f3081d8791499287

validate_secrets() {
  require_bun
  require_nonempty "$repo_dir/bin/pass-env.ts"
  validate_skill authenticated-commands
  PASS_ENV_SOURCE="$repo_dir" PASS_ENV_DEST="$agent_dir" PASS_ENV_RETIRED_SHA256="$retired_secrets_sha256" bun -e '
    import { lstat, readFile } from "node:fs/promises";
    import { isBuiltin } from "node:module";
    import { join } from "node:path";
    const source = process.env.PASS_ENV_SOURCE;
    const target = process.env.PASS_ENV_DEST;
    const home = process.env.HOME;
    const cli = join(source, "bin/pass-env.ts");
    const skill = join(source, "skills/authenticated-commands/SKILL.md");
    for (const path of [cli, skill]) {
      const info = await lstat(path);
      if (!info.isFile() || info.isSymbolicLink()) throw new Error(`Expected an ordinary source file: ${path}`);
    }
    const transpiler = new Bun.Transpiler({ loader: "ts" });
    const text = await readFile(cli, "utf8");
    transpiler.transformSync(text);
    for (const imported of transpiler.scan(text).imports) {
      if (imported.path !== "bun" && !isBuiltin(imported.path)) {
        throw new Error(`Standalone launcher cannot depend on external modules: ${imported.path}`);
      }
    }
    const skillText = await readFile(skill, "utf8");
    const frontmatter = /^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]+)$/.exec(skillText);
    if (!frontmatter || !frontmatter[2].trim()) throw new Error("Missing authenticated-commands skill instructions");
    const definition = Bun.YAML.parse(frontmatter[1]);
    if (!definition || definition.name !== "authenticated-commands" ||
        typeof definition.description !== "string" || !definition.description.trim() ||
        definition["disable-model-invocation"] === true) {
      throw new Error("Invalid or undiscoverable authenticated-commands skill");
    }
    const destination = join(home, ".local/bin/pass-env");
    const retired = join(home, ".local/bin/omp-secrets");
    for (const path of [join(home, ".local"), join(home, ".local/bin"), destination, retired,
        target, join(target, "skills"), join(target, "skills/authenticated-commands")]) {
      try {
        const info = await lstat(path);
        const valid = path === destination || path === retired ? info.isFile() : info.isDirectory();
        if (!valid || info.isSymbolicLink()) throw new Error(`Refusing invalid or symlinked secrets destination: ${path}`);
        if (path === destination && !(await readFile(path, "utf8")).startsWith(
            "#!/usr/bin/env bun\n// pass-env: owned standalone launcher (misty-step/omp-config)\n")) {
          throw new Error(`Refusing unowned launcher: ${path}`);
        }
        if (path === retired && new Bun.CryptoHasher("sha256").update(await readFile(path)).digest("hex") !== process.env.PASS_ENV_RETIRED_SHA256) {
          throw new Error(`Refusing unowned retired launcher: ${path}`);
        }
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
      }
    }
  '
}

install_secrets_cli() {
  install -d -m 700 "$HOME/.local/bin"
  install -m 700 "$repo_dir/bin/pass-env.ts" "$HOME/.local/bin/pass-env"
  PASS_ENV_RETIRED_SHA256="$retired_secrets_sha256" bun -e '
    import { lstat, readFile, unlink } from "node:fs/promises";
    import { join } from "node:path";
    const path = join(process.env.HOME, ".local/bin/omp-secrets");
    try {
      const info = await lstat(path);
      if (!info.isFile() || info.isSymbolicLink() ||
          new Bun.CryptoHasher("sha256").update(await readFile(path)).digest("hex") !== process.env.PASS_ENV_RETIRED_SHA256) {
        throw new Error(`Refusing unowned retired launcher: ${path}`);
      }
      await unlink(path);
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
  '
}

install_secrets() {
  install_secrets_cli
  install_skill authenticated-commands
}

if [ "${OMP_INSTALL_GUIDANCE_ONLY+x}" = x ]; then
  printf 'OMP_INSTALL_GUIDANCE_ONLY was replaced; use OMP_INSTALL_COMPONENTS=guidance\n' >&2
  exit 1
fi

# Split the explicit component list without expanding filesystem patterns.
set -f
set -- ${OMP_INSTALL_COMPONENTS-all}
set +f
[ "$#" -gt 0 ] || { echo "OMP_INSTALL_COMPONENTS must not be empty" >&2; exit 1; }

# Reject the entire selection before deploying anything.
for component do
  case $component in
    all)
      [ "$#" -eq 1 ] || { echo "all must be the only component" >&2; exit 1; }
      validate_config
      validate_guidance
      validate_mcp
      validate_scopes
      validate_owned_skills
      validate_agents
      validate_executive
      validate_themes
      validate_secrets
      require_nonempty "$repo_dir/bin/omp-grievances.ts"
      require_nonempty "$repo_dir/.githooks/pre-push"
      ;;
    guidance) validate_guidance ;;
    config) validate_config ;;
    mcp) validate_mcp ;;
    scopes) validate_scopes ;;
    agents) validate_agents ;;
    executive) validate_executive ;;
    secrets) validate_secrets ;;
    skill:*) validate_skill "${component#skill:}" ;;
    *)
      printf 'Unknown install component: %s\n' "$component" >&2
      exit 1
      ;;
  esac
done

if [ "$1" != all ]; then
  for component do
    case $component in
      guidance) install_guidance ;;
      config) install_config ;;
      mcp) install_mcp ;;
      scopes) install_scopes ;;
      agents) install_agents ;;
      executive) install_executive ;;
      secrets) install_secrets ;;
      skill:*) install_skill "${component#skill:}" ;;
    esac
  done
  printf 'Installed OMP components (%s) in %s; other deployed state unchanged\n' "$*" "$agent_dir"
  exit 0
fi

install_config
install_themes
install_guidance
install_agents
install_executive_extension
install_mcp
install_scopes
install_owned_skills
install_extensions
install_hooks
install_cli
install_secrets_cli

printf 'Installed owned OMP config in %s; foreign packages and runtime keys preserved\n' "$agent_dir"
