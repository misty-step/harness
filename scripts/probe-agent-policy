#!/usr/bin/env python3
"""Read-only sweep: canonical instruction files and generated verification policy."""
import argparse
import os
from pathlib import Path
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--verification', action='store_true', help='also check generated verification skills for the QA-account contract')
parser.add_argument('repos', nargs='*', default=['.'])
args = parser.parse_args()
failures = []
for repo in args.repos:
    root = Path(repo).resolve()
    if not root.is_dir():
        failures.append(f'{root}: repository directory missing')
        continue
    for directory, dirs, files in os.walk(root, followlinks=False):
        dirs[:] = [d for d in dirs if d not in {'.git', 'node_modules', '.cache', '.venv', '__pycache__'}]
        if 'CLAUDE.md' in files or 'CLAUDE.md' in dirs:
            alias = Path(directory) / 'CLAUDE.md'
            canonical = alias.with_name('AGENTS.md')
            if not alias.is_symlink() or os.readlink(alias) != 'AGENTS.md' or not canonical.is_file() or canonical.is_symlink():
                failures.append(f'{alias}: must be a symlink to regular sibling AGENTS.md')
    if args.verification:
        skills = list((root / '.agents/skills').glob('verify-*/SKILL.md'))
        if not skills:
            failures.append(f'{root}: no canonical verification skill')
        for skill in skills:
            text = skill.read_text()
            for required in ('AgentMail', 'workstation/<PROJECT>_QA_', 'production', 'owner/admin', 'AGENTS.md'):
                if required not in text:
                    failures.append(f'{skill}: missing verification contract term {required}')
            alias = root / '.claude/skills' / skill.parent.name
            if not alias.is_symlink() or alias.resolve() != skill.parent.resolve():
                failures.append(f'{alias}: must link to {skill.parent}')
for failure in failures:
    print(f'FAIL {failure}', file=sys.stderr)
if failures:
    sys.exit(1)
print('PASS canonical agent policy' + (' and generated verification QA contract' if args.verification else ''))
