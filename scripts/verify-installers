#!/bin/sh
# Test committed installer behavior in a fresh, credential-free clone.
# No live HOME, agent directory, scope, provider, or Git hook is touched.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for tool in git bun jq python3; do
  command -v "$tool" >/dev/null 2>&1 || { echo "FAIL prerequisite: $tool" >&2; exit 1; }
done
mkdir -p "$HOME/.cache/tmp"
work=$(mktemp -d "$HOME/.cache/tmp/harness-installers.XXXXXX")
trap 'rm -rf -- "$work"' 0
trap 'exit 130' 2
trap 'exit 143' 15
revision=$(git -C "$root" rev-parse HEAD)
git clone --quiet --no-hardlinks --no-local "$root" "$work/source"
git -C "$work/source" checkout --quiet --detach "$revision"
printf 'Testing committed revision: %s\n' "$revision"
failures=0
check() {
  label=$1
  shift
  if "$@"; then
    printf 'PASS %s\n' "$label"
  else
    printf 'FAIL %s\n' "$label" >&2
    failures=$((failures + 1))
  fi
}
for consumer in pi omp; do
  home="$work/$consumer-home"
  agent="$home/agent"
  mkdir -p "$agent/skills/foreign" "$home/development/r90group"
  printf 'foreign skill sentinel\n' > "$work/expected-skill"
  printf '{"synthetic":"auth sentinel","anthropic":{"type":"api_key","key":"synthetic-foreign"},"openrouter":{"type":"api_key","key":"synthetic-old"}}\n' > "$work/expected-auth"
  cp "$work/expected-skill" "$agent/skills/foreign/SKILL.md"
  cp "$work/expected-auth" "$agent/auth.json"
  mkdir -p "$agent/skills/foundation" "$home/.local/bin"
  printf 'retired foundation package\n' > "$agent/skills/foundation/SKILL.md"
  mkdir -p "$agent/skills/dev-exec"
  printf 'retired dev-exec package\n' > "$agent/skills/dev-exec/SKILL.md"
  printf '#!/usr/bin/env bun\n// review-check: owned standalone launcher (misty-step/harness).\n' > "$home/.local/bin/review-check"
  mkdir -p "$agent/extensions/diff-review" "$agent/extensions/continuation-nudge"
  printf 'retired review\n' > "$agent/extensions/diff-review/index.ts"
  printf 'retired nudge\n' > "$agent/extensions/continuation-nudge/index.ts"
  mkdir -p "$agent/extensions/loc"
  printf 'old owned LOC warming hook\n' > "$agent/extensions/loc/git-hook.sh"
  # Claude Code settings carry foreign keys the audio sandbox must preserve.
  mkdir -p "$home/.claude"
  printf '{"env":{"OTEL_LOGS_EXPORTER":"otlp"},"hooks":{"SessionStart":[]}}\n' > "$home/.claude/settings.json"
  if [ "$consumer" = omp ]; then
    mkdir -p "$agent/extensions/continuation-nudge"
    printf 'retired extension\n' > "$agent/extensions/continuation-nudge/index.ts"
    mkdir -p "$agent/extensions/diff-review"
    printf 'retired extension\n' > "$agent/extensions/diff-review/index.ts"
    mkdir -p "$agent/extensions/cwd"
    printf 'retired extension\n' > "$agent/extensions/cwd/index.ts"
    printf 'retired extension\n' > "$agent/extensions/loc/index.ts"
    mkdir -p "$agent/extensions/kaylee-pane-guard"
    printf 'retired extension\n' > "$agent/extensions/kaylee-pane-guard/index.ts"
    mkdir -p "$agent/extensions/subagent-inheritance" "$agent/bin"
    printf 'retired routing hook\n' > "$agent/extensions/subagent-inheritance/index.ts"
    printf 'retired routing tests\n' > "$agent/extensions/subagent-inheritance/index.test.ts"
    printf 'retired model validator\n' > "$agent/bin/omp-model-policy.ts"
    printf 'foreign routing sibling\n' > "$work/expected-routing-sibling"
    cp "$work/expected-routing-sibling" "$agent/extensions/subagent-inheritance/foreign.ts"
    mkdir -p "$home/.local/bin"
    printf 'foreign native executable sentinel\n' > "$work/expected-native"
    cp "$work/expected-native" "$home/.local/bin/omp"
    printf 'retired roster\n' > "$home/.local/bin/omp-roster"
    printf 'retired experiment controller\n' > "$home/.local/bin/omp-experiments.ts"
    printf '#!/usr/bin/env python3\n# owned by misty-step/harness omp-config auditors\n' > "$home/.local/bin/omp-audit"
    mkdir -p "$home/.local/state/omp-audit"
    printf 'retained audit history\n' > "$home/.local/state/omp-audit/history"
    mkdir -p "$home/.config/systemd/user" "$home/.fixture-bin"
    # An isolated HOME has no user manager. Acknowledge unit control locally;
    # assertions below cover file retirement, not live timer shutdown.
    printf '#!/bin/sh\nexit 0\n' > "$home/.fixture-bin/systemctl"
    chmod 700 "$home/.fixture-bin/systemctl"
    printf '# owned by misty-step/harness omp-config auditors\n[Service]\nType=oneshot\nExecStart=/usr/bin/true\n' > "$home/.config/systemd/user/omp-audit@.service"
    for name in foundations principles simplicity; do
      printf '# owned by misty-step/harness omp-config auditors\n[Timer]\nUnit=omp-audit@%s.service\nOnActiveSec=1h\n' "$name" > "$home/.config/systemd/user/omp-audit-$name.timer"
    done
    printf 'foreign presentation owner\n' > "$home/.config/systemd/user/forest-view.service"
    printf 'retired watchdog\n' > "$agent/WATCHDOG.md"
    printf '{"runtime":{"sentinel":true},"mcpServers":{"mobbin":{"type":"http","url":"https://example.invalid/old-mobbin","auth":{"synthetic":"mobbin-auth"},"oauth":{"synthetic":"mobbin-oauth"}},"foreign":{"type":"http","url":"https://example.invalid/foreign","auth":{"synthetic":"foreign-auth"}}},"disabledServers":["foreign"]}\n' > "$agent/mcp.json"
    printf '{"mcpServers":{"fastmail":{"type":"http","url":"https://example.invalid/fastmail"}}}\n' > "$work/expected-scope"
    printf '{"mcpServers":{"project-native":{"type":"http","url":"https://example.invalid/project"}}}\n' > "$work/expected-project-mcp"
    printf '# foreign local exclusions\n/.omp/.mcp.json\n' > "$work/expected-exclude"
    for owner in misty-step moomooskycow r90group; do
      scope="$home/development/$owner/.omp"
      project="$home/development/$owner/project"
      mkdir -p "$scope" "$project/.omp"
      git init --quiet "$project"
      cp "$work/expected-scope" "$scope/mcp.json"
      cp "$work/expected-project-mcp" "$project/.omp/mcp.json"
      cp "$work/expected-exclude" "$project/.git/info/exclude"
      ln -s ../../.omp/mcp.json "$project/.omp/.mcp.json"
    done
    for skill in herdr pr-preview sachstand session-close parlor ast-grep now-next; do
      mkdir -p "$agent/skills/$skill"
      printf 'old owned retired skill\n' > "$agent/skills/$skill/SKILL.md"
    done
  fi
  if env -i PATH="$home/.fixture-bin:$PATH" HOME="$home" TMPDIR="$work" \
    PI_CODING_AGENT_DIR="$agent" \
    OMP_TODOIST_OWNER="$home/missing-todoist" \
    "$work/source/$consumer-config/install" >"$work/$consumer.log" 2>&1; then
    printf 'PASS %s installer exit\n' "$consumer"
  else
    printf 'FAIL %s installer exit\n' "$consumer" >&2
    failures=$((failures + 1))
  fi

  if [ "$consumer" = pi ]; then
    # Pi still composes declared shared sections; OMP installs native guidance.
    expected="$work/$consumer-guidance"
    : > "$expected"
    while IFS= read -r line || [ -n "$line" ]; do
      if [ "$line" = '<!-- shared guidance: agent-config -->' ]; then
        for section in engineering workstation; do
          # Match the shared contract: a blank separator follows each section.
          awk '{ print }' "$work/source/agent-config/guidance/$section.md" >> "$expected"
          printf '\n' >> "$expected"
        done
      else
        printf '%s\n' "$line" >> "$expected"
      fi
    done < "$work/source/$consumer-config/global/AGENTS.md"
    check "$consumer composition" cmp -s "$expected" "$agent/AGENTS.md"
  fi
  check "$consumer launcher executable" test -x "$home/.local/bin/pass-env"
  check "$consumer OpenRouter launcher executable" test -x "$home/.local/bin/openrouter-key"
  check "$consumer removes installed foundation package" test ! -e "$agent/skills/foundation"
  check "$consumer removes installed dev-exec package" test ! -e "$agent/skills/dev-exec"
  check "$consumer removes installed review-check" test ! -e "$home/.local/bin/review-check"
  check "$consumer removes automatic review" test ! -e "$agent/extensions/diff-review"
  check "$consumer removes automatic nudge" test ! -e "$agent/extensions/continuation-nudge"
  if [ "$consumer" = omp ]; then
    for skill in herdr pr-preview sachstand session-close parlor ast-grep now-next; do
      check "omp retires $skill" test ! -e "$agent/skills/$skill"
    done
  fi
  check "$consumer foreign skill" cmp -s "$work/expected-skill" "$agent/skills/foreign/SKILL.md"
  if [ "$consumer" = pi ]; then
    check "pi retires installed LOC warming hook" test ! -e "$agent/extensions/loc/git-hook.sh"
    # US-028: Pi replaces only its OpenRouter mapping, retaining foreign auth.
    check "pi OpenRouter auth mapping and foreign credential" \
      jq -e '.synthetic == "auth sentinel" and .anthropic == {type:"api_key",key:"synthetic-foreign"} and .openrouter == {type:"api_key",key:"!openrouter-key --personal workstation/OPENROUTER_MISTY_STEP_HARNESS_WORKSTATION_RECOVERY_API_KEY"}' "$agent/auth.json"
    check "pi auth permissions" test "$(stat -c %a "$agent/auth.json")" = 600
  else
    check "omp auth untouched" cmp -s "$work/expected-auth" "$agent/auth.json"
    check "omp MCP preserves foreign inventory, auth and runtime settings" \
      jq -e '
        .runtime == {sentinel:true}
        and .mcpServers.mobbin.url == "https://api.mobbin.com/mcp"
        and .mcpServers.mobbin.auth == {synthetic:"mobbin-auth"}
        and .mcpServers.mobbin.oauth == {synthetic:"mobbin-oauth"}
        and .mcpServers.foreign == {type:"http",url:"https://example.invalid/foreign",auth:{synthetic:"foreign-auth"}}
        and .mcpServers.openrouter.enabled == false
        and (.disabledServers | sort) == ["chrome-devtools","foreign","node_repl"]
      ' "$agent/mcp.json"
    check "omp MCP permissions" test "$(stat -c %a "$agent/mcp.json")" = 600
    for owner in misty-step moomooskycow r90group; do
      scope="$home/development/$owner/.omp"
      project="$home/development/$owner/project"
      check "omp preserves $owner owner MCP scope" cmp -s "$work/expected-scope" "$scope/mcp.json"
      check "omp preserves $owner primary project MCP" cmp -s "$work/expected-project-mcp" "$project/.omp/mcp.json"
      check "omp preserves $owner MCP import target" test "$(readlink "$project/.omp/.mcp.json")" = ../../.omp/mcp.json
      check "omp preserves $owner imported MCP definition" cmp -s "$work/expected-scope" "$project/.omp/.mcp.json"
      check "omp preserves $owner local Git exclusions" cmp -s "$work/expected-exclude" "$project/.git/info/exclude"
    done
    check "omp default install preserves native entrypoint" cmp -s "$work/expected-native" "$home/.local/bin/omp"
    check "omp default install does not activate memory units" test ! -e "$home/.config/systemd/user/omp.slice"
    check "omp removes installed roster" test ! -e "$home/.local/bin/omp-roster"
    check "omp removes installed experiment controller" test ! -e "$home/.local/bin/omp-experiments.ts"
    check "omp removes installed obsolete auditor" test ! -e "$home/.local/bin/omp-audit"
    check "omp preserves audit history" grep -Fxq 'retained audit history' "$home/.local/state/omp-audit/history"
    for name in omp-audit@.service omp-audit-foundations.timer omp-audit-principles.timer omp-audit-simplicity.timer; do
      check "omp removes owned $name" test ! -e "$home/.config/systemd/user/$name"
    done
    check "omp preserves foreign presentation owner" grep -Fxq 'foreign presentation owner' "$home/.config/systemd/user/forest-view.service"
    check "omp removes installed watchdog" test ! -e "$agent/WATCHDOG.md"
    check "omp engineer launcher bytes" cmp -s "$work/source/omp-config/bin/omp-engineer.py" "$home/.local/bin/omp-engineer"
    check "omp engineer launcher executable" test -x "$home/.local/bin/omp-engineer"
    check "omp engineer launcher installed load" "$home/.local/bin/omp-engineer" --help
    check "omp OpenRouter personal billing entry" \
      env -i PATH="$home/.local/bin:$PATH" HOME="$home" AGENT="$agent" bun -e '
        const doc = Bun.YAML.parse(await Bun.file(`${process.env.AGENT}/models.yml`).text());
        const command = doc.providers.openrouter.apiKey.slice(1).split(/\s+/);
        const result = Bun.spawnSync([...command, "--which"], { cwd: process.env.HOME });
        if (result.exitCode !== 0 || result.stdout.toString().trim() !== "workstation/OPENROUTER_MISTY_STEP_HARNESS_WORKSTATION_DIFF_REVIEW_API_KEY") throw new Error("wrong personal billing entry");
      '
  fi
  # US-026: both routing layers, the silent-sink drop-in, and Claude Code env
  # deploy; the installed extension applies the contract self-contained; and
  # the isolated run (no XDG_RUNTIME_DIR) never reaches live PipeWire.
  check "$consumer audio-sandbox deploy" \
    env -i PATH="$PATH" HOME="$home" TMPDIR="$work" CONSUMER="$consumer" AGENT="$agent" SOURCE="$work/source" \
    bun -e '
      const { readFileSync } = await import("node:fs");
      const { parseEnv } = await import("node:util");
      const { AGENT_AUDIO_ENV, shellExports } = await import(`${process.env.SOURCE}/agent-config/audio-sandbox/env.ts`);
      const { HOME: home, AGENT: agent } = process.env;
      const expectEqual = (actual, expected, what) => {
        if (!Bun.deepEquals(actual, expected)) throw new Error(`${what}: ${JSON.stringify(actual)}`);
      };
      const claude = JSON.parse(readFileSync(`${home}/.claude/settings.json`, "utf8"));
      expectEqual(claude.hooks, { SessionStart: [] }, "Claude Code hooks");
      expectEqual(claude.env, { OTEL_LOGS_EXPORTER: "otlp", ...AGENT_AUDIO_ENV }, "Claude Code env");
      const dropIn = readFileSync(`${home}/.config/pipewire/pipewire.conf.d/60-agent-sandbox.conf`, "utf8");
      if (!dropIn.startsWith("# owned by misty-step/harness agent-config audio-sandbox")) throw new Error("PipeWire drop-in");
      if (process.env.CONSUMER === "omp") expectEqual(parseEnv(readFileSync(`${agent}/.env`, "utf8")), { ...AGENT_AUDIO_ENV }, "OMP .env");
      else expectEqual(JSON.parse(readFileSync(`${agent}/settings.json`, "utf8")).shellCommandPrefix, shellExports(), "Pi prefix");
      const extension = await import(`${agent}/extensions/audio-sandbox/index.ts`);
      extension.default({ on() {} });
      expectEqual(Object.fromEntries(Object.keys(AGENT_AUDIO_ENV).map(name => [name, process.env[name]])), { ...AGENT_AUDIO_ENV }, "extension env");
    '
  check "$consumer audio-sandbox left live PipeWire alone" grep -q 'PipeWire is not reachable' "$work/$consumer.log"
  if [ "$consumer" = pi ]; then
    # US-026: pi-config owns shellCommandPrefix. Its own prefix redeploys
    # unchanged; a foreign one stops the install in preflight, before any write.
    cp "$agent/settings.json" "$work/pi-settings-owned"
    if env -i PATH="$PATH" HOME="$home" TMPDIR="$work" PI_CODING_AGENT_DIR="$agent" PI_CONFIG_COMPONENTS=audio-sandbox \
      "$work/source/pi-config/install" >"$work/pi-prefix.log" 2>&1 && cmp -s "$work/pi-settings-owned" "$agent/settings.json"; then
      printf 'PASS pi audio prefix redeploys unchanged\n'
    else
      printf 'FAIL pi audio prefix redeploys unchanged\n' >&2
      cat "$work/pi-prefix.log" >&2
      failures=$((failures + 1))
    fi
    jq '.shellCommandPrefix = "shopt -s expand_aliases"' "$work/pi-settings-owned" > "$agent/settings.json"
    cp "$agent/settings.json" "$work/pi-settings-foreign"
    rm -rf "$agent/extensions/audio-sandbox"
    if env -i PATH="$PATH" HOME="$home" TMPDIR="$work" PI_CODING_AGENT_DIR="$agent" PI_CONFIG_COMPONENTS=audio-sandbox \
      "$work/source/pi-config/install" >"$work/pi-prefix.log" 2>&1; then
      printf 'FAIL pi audio prefix refuses a foreign prefix (install succeeded)\n' >&2
      failures=$((failures + 1))
    elif grep -q 'foreign shellCommandPrefix' "$work/pi-prefix.log" \
      && cmp -s "$work/pi-settings-foreign" "$agent/settings.json" \
      && [ ! -e "$agent/extensions/audio-sandbox" ]; then
      printf 'PASS pi audio prefix refuses a foreign prefix before any write\n'
    else
      printf 'FAIL pi audio prefix refuses a foreign prefix before any write\n' >&2
      cat "$work/pi-prefix.log" >&2
      failures=$((failures + 1))
    fi
  fi

  if [ "$consumer" = omp ]; then
    check "omp continuation-nudge retired" test ! -e "$agent/extensions/continuation-nudge"
    check "omp diff-review retired" test ! -e "$agent/extensions/diff-review"
    check "omp cwd retired" test ! -e "$agent/extensions/cwd"
    check "omp loc retired" test ! -e "$agent/extensions/loc"
    check "omp kaylee-pane-guard retired" test ! -e "$agent/extensions/kaylee-pane-guard"
    check "omp inheritance hook retired" test ! -e "$agent/extensions/subagent-inheritance/index.ts"
    check "omp inheritance tests retired" test ! -e "$agent/extensions/subagent-inheritance/index.test.ts"
    check "omp model validator retired" test ! -e "$agent/bin/omp-model-policy.ts"
    check "omp foreign routing sibling preserved" cmp -s "$work/expected-routing-sibling" "$agent/extensions/subagent-inheritance/foreign.ts"
  fi
done
# Claude Code: selected skills land beside foreign and CLI-linked skills, and
# composed guidance lands in the user-scope CLAUDE.md every session loads.
claude_home="$work/claude-home"
claude="$claude_home/.claude"
mkdir -p "$claude/skills/foreign" "$claude/skills/lage"
printf 'foreign skill sentinel\n' > "$claude/skills/foreign/SKILL.md"
printf 'stale owned lage\n' > "$claude/skills/lage/obsolete.md"
mkdir -p "$claude/skills/foundation" "$claude/skills/dev-exec"
printf 'foreign foundation skill\n' > "$claude/skills/foundation/SKILL.md"
printf 'foreign dev-exec skill\n' > "$claude/skills/dev-exec/SKILL.md"
ln -s ../../.agents/skills/code-review "$claude/skills/code-review"
printf '{"foreign":"keep"}\n' > "$claude/settings.json"
cp "$claude/settings.json" "$work/expected-claude-settings"
if env -i PATH="$PATH" HOME="$claude_home" TMPDIR="$work" \
  "$work/source/claude-config/install" >"$work/claude.log" 2>&1; then
  printf 'PASS claude installer exit\n'
else
  printf 'FAIL claude installer exit\n' >&2
  cat "$work/claude.log" >&2
  failures=$((failures + 1))
fi
for skill in lage ship-loop judge release-watch heartbeat story-qa pokayoke user-stories authenticated-commands; do
  check "claude $skill skill bytes" cmp -s "$work/source/agent-config/skills/$skill/SKILL.md" "$claude/skills/$skill/SKILL.md"
done
check "claude release-watch package bytes" diff -r "$work/source/agent-config/skills/release-watch" "$claude/skills/release-watch"
check "claude ship-loop role briefs" cmp -s "$work/source/agent-config/skills/ship-loop/roles.md" "$claude/skills/ship-loop/roles.md"
check "claude clean-replaces owned skill" test ! -e "$claude/skills/lage/obsolete.md"
check "claude foreign skill" cmp -s "$work/expected-skill" "$claude/skills/foreign/SKILL.md"
check "claude keeps a foreign foundation skill" grep -Fxq 'foreign foundation skill' "$claude/skills/foundation/SKILL.md"
check "claude keeps a foreign dev-exec skill" grep -Fxq 'foreign dev-exec skill' "$claude/skills/dev-exec/SKILL.md"
check "claude CLI-linked skill" test "$(readlink "$claude/skills/code-review")" = ../../.agents/skills/code-review
check "claude settings untouched" cmp -s "$work/expected-claude-settings" "$claude/settings.json"
expected="$work/claude-guidance"
: > "$expected"
while IFS= read -r line || [ -n "$line" ]; do
  if [ "$line" = '<!-- shared guidance: agent-config -->' ]; then
    for section in engineering workstation autonomy; do
      cat "$work/source/agent-config/guidance/$section.md" >> "$expected"
      printf '\n' >> "$expected"
    done
  else
    printf '%s\n' "$line" >> "$expected"
  fi
done < "$work/source/claude-config/global/CLAUDE.md"
check "claude composition" cmp -s "$expected" "$claude/CLAUDE.md"
check "claude writes no AGENTS.md" test ! -e "$claude/AGENTS.md"
# A rerun replaces its own CLAUDE.md; a foreign one stops the install before any write.
if env -i PATH="$PATH" HOME="$claude_home" TMPDIR="$work" \
  "$work/source/claude-config/install" >"$work/claude-rerun.log" 2>&1 && cmp -s "$expected" "$claude/CLAUDE.md"; then
  printf 'PASS claude rerun replaces its own CLAUDE.md\n'
else
  printf 'FAIL claude rerun replaces its own CLAUDE.md\n' >&2
  failures=$((failures + 1))
fi
foreign_home="$work/claude-foreign-home"
mkdir -p "$foreign_home/.claude"
printf '# my own notes\n' > "$foreign_home/.claude/CLAUDE.md"
if env -i PATH="$PATH" HOME="$foreign_home" TMPDIR="$work" \
  "$work/source/claude-config/install" >"$work/claude-foreign.log" 2>&1; then
  printf 'FAIL claude refuses a foreign CLAUDE.md (install succeeded)\n' >&2
  failures=$((failures + 1))
else
  check "claude refuses a foreign CLAUDE.md before any write" \
    test "$(ls -A "$foreign_home/.claude")" = CLAUDE.md
  check "claude keeps the foreign CLAUDE.md" grep -Fxq '# my own notes' "$foreign_home/.claude/CLAUDE.md"
fi
# The ownership marker counts only as the file's first line.
marker_home="$work/claude-marker-home"
mkdir -p "$marker_home/.claude"
printf '# my own notes\n\n<!-- owned by misty-step/harness claude-config -->\n' > "$marker_home/.claude/CLAUDE.md"
cp "$marker_home/.claude/CLAUDE.md" "$work/expected-marker-claude"
if env -i PATH="$PATH" HOME="$marker_home" TMPDIR="$work" \
  "$work/source/claude-config/install" >"$work/claude-marker.log" 2>&1; then
  printf 'FAIL claude refuses a CLAUDE.md with the marker on a later line (install succeeded)\n' >&2
  failures=$((failures + 1))
else
  check "claude refuses a CLAUDE.md with the marker on a later line before any write" \
    test "$(ls -A "$marker_home/.claude")" = CLAUDE.md
  check "claude keeps a CLAUDE.md with the marker on a later line" \
    cmp -s "$work/expected-marker-claude" "$marker_home/.claude/CLAUDE.md"
fi
# Codex: selected skills land beside its bundled .system skills and foreign
# links, composed guidance lands in $CODEX_HOME/AGENTS.md, and config.toml,
# credentials and runtime state stay untouched.
codex_home="$work/codex-home"
codex="$codex_home/.codex"
mkdir -p "$codex/skills/foreign" "$codex/skills/lage" "$codex/skills/.system/imagegen"
printf 'foreign skill sentinel\n' > "$codex/skills/foreign/SKILL.md"
printf 'stale owned lage\n' > "$codex/skills/lage/obsolete.md"
printf 'bundled system skill\n' > "$codex/skills/.system/imagegen/SKILL.md"
ln -s /usr/share/omarchy/default/agents/skills/omarchy "$codex/skills/omarchy"
printf 'model = "synthetic"\n[projects."/synthetic"]\ntrust_level = "trusted"\n' > "$codex/config.toml"
printf '{"synthetic":"codex auth sentinel"}\n' > "$codex/auth.json"
cp "$codex/config.toml" "$work/expected-codex-config"
cp "$codex/auth.json" "$work/expected-codex-auth"
if env -i PATH="$PATH" HOME="$codex_home" TMPDIR="$work" \
  "$work/source/codex-config/install" >"$work/codex.log" 2>&1; then
  printf 'PASS codex installer exit\n'
else
  printf 'FAIL codex installer exit\n' >&2
  cat "$work/codex.log" >&2
  failures=$((failures + 1))
fi
for skill in lage ship-loop judge release-watch heartbeat story-qa pokayoke user-stories authenticated-commands; do
  check "codex $skill skill package" diff -r "$work/source/agent-config/skills/$skill" "$codex/skills/$skill"
done
check "codex clean-replaces owned skill" test ! -e "$codex/skills/lage/obsolete.md"
check "codex foreign skill" cmp -s "$work/expected-skill" "$codex/skills/foreign/SKILL.md"
check "codex keeps bundled system skills" grep -Fxq 'bundled system skill' "$codex/skills/.system/imagegen/SKILL.md"
check "codex keeps linked skill" test "$(readlink "$codex/skills/omarchy")" = /usr/share/omarchy/default/agents/skills/omarchy
check "codex config.toml untouched" cmp -s "$work/expected-codex-config" "$codex/config.toml"
check "codex auth untouched" cmp -s "$work/expected-codex-auth" "$codex/auth.json"
expected="$work/codex-guidance"
: > "$expected"
while IFS= read -r line || [ -n "$line" ]; do
  if [ "$line" = '<!-- shared guidance: agent-config -->' ]; then
    for section in engineering workstation autonomy; do
      cat "$work/source/agent-config/guidance/$section.md" >> "$expected"
      printf '\n' >> "$expected"
    done
  else
    printf '%s\n' "$line" >> "$expected"
  fi
done < "$work/source/codex-config/global/AGENTS.md"
check "codex composition" cmp -s "$expected" "$codex/AGENTS.md"
check "codex AGENTS.md permissions" test "$(stat -c %a "$codex/AGENTS.md")" = 600
check "codex writes no CLAUDE.md" test ! -e "$codex/CLAUDE.md"
# CODEX_HOME relocates the whole deployment, as it does for Codex itself.
relocated="$work/codex-relocated"
if env -i PATH="$PATH" HOME="$work/codex-unused-home" CODEX_HOME="$relocated" TMPDIR="$work" \
  "$work/source/codex-config/install" >"$work/codex-relocated.log" 2>&1 \
  && cmp -s "$expected" "$relocated/AGENTS.md" && test -f "$relocated/skills/lage/SKILL.md" \
  && test ! -e "$work/codex-unused-home/.codex"; then
  printf 'PASS codex honors CODEX_HOME\n'
else
  printf 'FAIL codex honors CODEX_HOME\n' >&2
  failures=$((failures + 1))
fi
# A rerun replaces its own AGENTS.md; a foreign one stops the install before any write.
if env -i PATH="$PATH" HOME="$codex_home" TMPDIR="$work" \
  "$work/source/codex-config/install" >"$work/codex-rerun.log" 2>&1 && cmp -s "$expected" "$codex/AGENTS.md"; then
  printf 'PASS codex rerun replaces its own AGENTS.md\n'
else
  printf 'FAIL codex rerun replaces its own AGENTS.md\n' >&2
  failures=$((failures + 1))
fi
for variant in foreign marker; do
  variant_home="$work/codex-$variant-home"
  mkdir -p "$variant_home/.codex"
  if [ "$variant" = foreign ]; then
    printf '# my own notes\n' > "$variant_home/.codex/AGENTS.md"
  else
    # The ownership marker counts only as the file's first line.
    printf '# my own notes\n\n<!-- owned by misty-step/harness codex-config -->\n' > "$variant_home/.codex/AGENTS.md"
  fi
  cp "$variant_home/.codex/AGENTS.md" "$work/expected-codex-$variant"
  if env -i PATH="$PATH" HOME="$variant_home" TMPDIR="$work" \
    "$work/source/codex-config/install" >"$work/codex-$variant.log" 2>&1; then
    printf 'FAIL codex refuses a %s AGENTS.md (install succeeded)\n' "$variant" >&2
    failures=$((failures + 1))
  else
    check "codex refuses a $variant AGENTS.md before any write" \
      test "$(ls -A "$variant_home/.codex")" = AGENTS.md
    check "codex keeps the $variant AGENTS.md" cmp -s "$work/expected-codex-$variant" "$variant_home/.codex/AGENTS.md"
  fi
done
if [ "$failures" -ne 0 ]; then
  printf 'FAIL: %s invariant(s); disposable clone removed on exit\n' "$failures" >&2
  exit 1
fi
printf 'PASS: all installers; disposable clone removed on exit\n'
