# Copy to ~/.config/daybook/publish.env and chmod 600 it.
DAYBOOK_CONFIG_REPOSITORY=example-org/daybook
DAYBOOK_CONFIG_REF=main
DAYBOOK_CONFIG_STATE_DIR="$HOME/.local/state/daybook-publish"
DAYBOOK_CONFIG_HOST_DIR="$HOME/.local/share/daybook-host"
DAYBOOK_CONFIG_LIVE_URL=https://host-a.example.ts.net/data/priorities.json
DAYBOOK_CONFIG_READER_ENV="$HOME/.config/daybook/reader.env"
DAYBOOK_CONFIG_FRESH_MIN=30
DAYBOOK_CONFIG_VERIFY_TRIES=8
DAYBOOK_CONFIG_VERIFY_SLEEP=10
