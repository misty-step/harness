{
  "name": "summon-factory-canary",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  "main": "worker/build/worker/shim.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "SUMMON_RUNS", "class_name": "SummonRun" }]
  },
  "migrations": [{ "tag": "hosted-v1", "new_sqlite_classes": ["SummonRun"] }],
  "vars": { "FACTORY_MODE": "hosted" },
  // Source only. No Access app/audience, principals or resources allocated.
  // Missing FACTORY_AUTH_POLICY denies every request. Supply only reviewed
  // server-owned grants and a fresh instance/namespace, never old local rows.
  "dev": { "ip": "127.0.0.1", "port": 8792 }
}
