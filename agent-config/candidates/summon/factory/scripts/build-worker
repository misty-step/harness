#!/bin/sh
# Build glue only; all run/protocol/state logic is Rust.
set -eu
factory=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$factory"
export CARGO_BUILD_JOBS=2
: "${TMPDIR:=$HOME/.cache/tmp/summon-build-$$}"
export TMPDIR
mkdir -p "$TMPDIR"
git diff --quiet HEAD -- . || { echo 'Commit factory source before exact-revision build' >&2; exit 1; }
[ -z "$(git ls-files --others --exclude-standard -- .)" ] || { echo 'Untracked factory source must be committed first' >&2; exit 1; }
cargo test --locked -p summon-protocol -- --test-threads=1
(cd worker && worker-build --release --locked)
python3 - <<'PY'
import hashlib, json, pathlib, subprocess
root = pathlib.Path('worker/build')
files = ['index_bg.wasm', 'index.js', 'worker/shim.mjs']
manifest = {
    'head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
    'files': {file: hashlib.sha256((root / file).read_bytes()).hexdigest() for file in files},
}
(root / 'source-revision.json').write_text(json.dumps(manifest) + '\n')
print(json.dumps(manifest))
PY
if [ -n "${WS_EVIDENCE:-}" ]; then
    tar -czf "$WS_EVIDENCE/worker-build.tgz" -C worker build
fi
