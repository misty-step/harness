#!/usr/bin/env bash
# Cut the retired legacy fleet's engineering access to this host once its last
# sessions finish. That fleet reached the host only through Tailscale SSH; the
# owner's own access uses the VM provider's SSH proxy, which this does not touch.
# An optional private marker file names an authorized_keys entry to drop too.
# Idempotent.
set -euo pipefail

if [[ $(sudo -n tailscale debug prefs | jq -r .RunSSH) == true ]]; then
  sudo -n tailscale set --ssh=false
  echo "tailscale ssh disabled on this host"
else
  echo "tailscale ssh already disabled"
fi

marker_file=$HOME/.config/kaylee/legacy-ssh-key-marker
keys=$HOME/.ssh/authorized_keys
[[ -s $marker_file && -f $keys ]] || exit 0
marker=$(<"$marker_file")
if grep -qF -- "$marker" "$keys"; then
  tmp=$(mktemp "$keys.XXXXXX")
  grep -vF -- "$marker" "$keys" >"$tmp" || true
  chmod 0600 "$tmp"
  mv "$tmp" "$keys"
  echo "removed the legacy key from $keys"
else
  echo "legacy key already absent from $keys"
fi
