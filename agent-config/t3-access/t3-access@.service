# owned by misty-step/harness t3-access
[Unit]
Description=Check T3 access to %i and report transitions to Home

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/t3-agent/watch.env
ExecStart=%h/.local/bin/t3-agent --server %i check --notify --report-url ${T3_ACCESS_REPORT_URL} --state %h/.local/state/t3-agent/%i.json
TimeoutStartSec=2min
UMask=0077
