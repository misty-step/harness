#!/bin/sh
# Deploy shared agent primitives into a harness agent directory.
#
# This repo owns harness-neutral primitives: skill packages, shared guidance
# sections, standalone launchers, audio sandbox and session backup.
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
marker='<!-- shared guidance: agent-config -->'
skill_marker='owned by misty-step/harness agent-config'

usage() {
  cat <<'EOF'
Usage: install [--agent-dir DIR] [--check] [--home DIR]
               [--skill NAME|all]... [--preserve-foreign-skills]
               [--bin NAME]...
               [--guidance NAME]... --guidance-source FILE [--guidance-file NAME]
               [--audio-sandbox] [--session-backup]

  --agent-dir DIR        Harness agent directory (required for agent primitives).
  --home DIR             Home for ~/.local/bin tools (default $HOME).
  --skill NAME|all       Skill package to clean-replace; repeatable.
  --preserve-foreign-skills Refuse unmarked skill collisions; retire only marked skills.
  --bin NAME             Standalone launcher to install; repeatable.
  --guidance NAME        Shared guidance section to inject; repeatable.
  --guidance-source FILE Harness AGENTS.md holding the insertion marker.
  --guidance-file NAME   Composed file in the agent directory: AGENTS.md
                         (default) or CLAUDE.md.
  --audio-sandbox        Silent agent sink, Claude Code env, and live proof.
  --session-backup       Install session backup CLI, credential references and inactive user timer.
  --check                Validate the selection; write nothing.
EOF
}

agent_dir=
home_dir=${HOME}
guidance_source=
guidance_file=AGENTS.md
check=0
skills=
preserve_foreign_skills=0
bins=
guidance=
audio_sandbox=0
session_backup=0

while [ $# -gt 0 ]; do
  case "$1" in
    --agent-dir) agent_dir=${2-}; shift 2 ;;
    --home) home_dir=${2-}; shift 2 ;;
    --skill) skills="$skills ${2-}"; shift 2 ;;
    --preserve-foreign-skills) preserve_foreign_skills=1; shift ;;
    --bin) bins="$bins ${2-}"; shift 2 ;;
    --guidance) guidance="$guidance ${2-}"; shift 2 ;;
    --guidance-source) guidance_source=${2-}; shift 2 ;;
    --guidance-file) guidance_file=${2-}; shift 2 ;;
    --audio-sandbox) audio_sandbox=1; shift ;;
    --session-backup) session_backup=1; shift ;;
    --check) check=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
done

require_nonempty() {
  [ -s "$1" ] || {
    printf 'Missing or empty source: %s\n' "$1" >&2
    exit 1
  }
}

require_bun() {
  command -v bun >/dev/null 2>&1 || { echo "bun is required" >&2; exit 1; }
}

agent_selection=0
if [ -n "$skills$bins$guidance$guidance_source" ] || [ "$audio_sandbox" = 1 ]; then agent_selection=1; fi
if [ -z "$agent_dir" ] && { [ "$session_backup" = 0 ] || [ "$agent_selection" = 1 ]; }; then
  echo "--agent-dir is required for agent primitives" >&2; usage >&2; exit 1
fi

# Expand "all" to every skill package, preserving the declared order otherwise.
skill_list=
for name in $skills; do
  if [ "$name" = all ]; then
    for dir in "$repo_dir"/skills/*; do
      [ -d "$dir" ] || continue
      skill_list="$skill_list ${dir##*/}"
    done
  else
    skill_list="$skill_list $name"
  fi
done

owns_skill() {
  [ -d "$1" ] && [ ! -L "$1" ] &&
    [ -f "$1/.harness-owned" ] && [ ! -L "$1/.harness-owned" ] &&
    [ "$(cat "$1/.harness-owned")" = "$skill_marker" ]
}

validate_skills() {
  for name in $skill_list; do
    case "$name" in
      ''|*/*|.|..) printf 'Invalid skill name: %s\n' "$name" >&2; exit 1 ;;
    esac
    require_nonempty "$repo_dir/skills/$name/SKILL.md"
    destination="$agent_dir/skills/$name"
    if [ "$preserve_foreign_skills" = 1 ] && { [ -e "$destination" ] || [ -L "$destination" ]; }; then
      if ! owns_skill "$destination"; then
        printf 'warning: refusing unowned skill destination: %s\n' "$destination" >&2
        exit 1
      fi
    fi
  done
}

validate_guidance() {
  for name in $guidance; do
    case "$name" in
      ''|*/*|.|..) printf 'Invalid guidance name: %s\n' "$name" >&2; exit 1 ;;
    esac
    require_nonempty "$repo_dir/guidance/$name.md"
  done
  case "$guidance_file" in
    AGENTS.md|CLAUDE.md) ;;
    *) printf 'Invalid guidance file: %s\n' "$guidance_file" >&2; exit 1 ;;
  esac
  if [ -n "$guidance" ] || [ -n "$guidance_source" ]; then
    require_nonempty "$guidance_source"
    grep -Fqx "$marker" "$guidance_source" || {
      printf 'Guidance source lacks the insertion marker %s: %s\n' "$marker" "$guidance_source" >&2
      exit 1
    }
  fi
}

# A standalone launcher carries an ownership header on its second line. The
# prefix match accepts an earlier owner's header so a launcher this repo now
# owns can be upgraded in place, while a foreign file is still refused.
validate_launcher_header() {
  [ "$(sed -n 1p "$1")" = '#!/usr/bin/env bun' ] || return 1
  sed -n 2p "$1" | grep -Fq -- ': owned standalone launcher (misty-step/' || return 1
}

validate_bin() {
  name=$1
  case "$name" in
    ''|*/*|.|..) printf 'Invalid launcher name: %s\n' "$name" >&2; exit 1 ;;
  esac
  require_nonempty "$repo_dir/bin/$name"
  case "$name" in
    *.ts)
      require_bun
      validate_launcher_header "$repo_dir/bin/$name" || {
        printf 'Standalone launcher lacks its ownership header: %s\n' "$name" >&2
        exit 1
      }
      bun --no-env-file --no-install "$repo_dir/bin/launcher-build.ts" "$repo_dir/bin/$name"
      dest="$home_dir/.local/bin/${name%.ts}"
      if [ -e "$dest" ] || [ -L "$dest" ]; then
        if [ ! -f "$dest" ] || [ -L "$dest" ] || ! validate_launcher_header "$dest"; then
          printf 'Refusing unowned launcher destination: %s\n' "$dest" >&2
          exit 1
        fi
      fi
      ;;
  esac
}

validate_bins() {
  for name in $bins; do
    validate_bin "$name"
  done
}

# The audio sandbox validates its own destinations (an unowned PipeWire drop-in
# or malformed Claude Code settings fail closed) before any write.
validate_audio_sandbox() {
  [ "$audio_sandbox" = 1 ] || return 0
  require_bun
  require_nonempty "$repo_dir/audio-sandbox/env.ts"
  require_nonempty "$repo_dir/audio-sandbox/install.ts"
  bun "$repo_dir/audio-sandbox/install.ts" host --home "$home_dir" --check
}


session_backup_files() {
  printf '%s\n' \
    "backup.py:.local/bin/agent-session-backup" \
    "env.pass:.config/agent-session-backup.env.pass" \
    "agent-session-backup.service:.config/systemd/user/agent-session-backup.service" \
    "agent-session-backup.timer:.config/systemd/user/agent-session-backup.timer"
}

validate_session_backup() {
  [ "$session_backup" = 1 ] || return 0
  command -v python3 >/dev/null 2>&1 || { echo "python3 is required for session backup" >&2; exit 1; }
  for pair in $(session_backup_files); do
    source="$repo_dir/session-backup/${pair%%:*}"
    destination="$home_dir/${pair#*:}"
    require_nonempty "$source"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
      if [ ! -f "$destination" ] || [ -L "$destination" ] ||
        ! grep -Fqx '# owned by misty-step/harness agent-session-backup' "$destination"; then
        printf 'Refusing foreign session backup destination: %s\n' "$destination" >&2
        exit 1
      fi
    fi
  done
}

install_session_backup() {
  for pair in $(session_backup_files); do
    destination="$home_dir/${pair#*:}"
    install -d -m 700 "$(dirname -- "$destination")"
    mode=600
    [ "${pair%%:*}" != backup.py ] || mode=700
    install -m "$mode" "$repo_dir/session-backup/${pair%%:*}" "$destination"
  done
}

install_skill() {
  name=$1
  install -d -m 700 "$agent_dir/skills"
  temp=$(mktemp -d "$agent_dir/skills/.$name.XXXXXX")
  trap 'rm -rf "$temp"' 0 1 2 15
  cp -R "$repo_dir/skills/$name"/. "$temp"/
  if [ "$preserve_foreign_skills" = 1 ]; then
    printf '%s\n' "$skill_marker" > "$temp/.harness-owned"
  fi
  chmod -R u=rwX,go= "$temp"
  rm -rf -- "$agent_dir/skills/$name"
  mv "$temp" "$agent_dir/skills/$name"
  trap - 0 1 2 15
}

install_bin() {
  name=$1
  case "$name" in
    *.ts)
      mkdir -p "$home_dir/.cache/tmp"
      temp=$(mktemp "$home_dir/.cache/tmp/.${name%.ts}.XXXXXX")
      trap 'rm -f "$temp"' 0 1 2 15
      bun --no-env-file --no-install "$repo_dir/bin/launcher-build.ts" "$repo_dir/bin/$name" "$temp"
      dest="$home_dir/.local/bin/${name%.ts}"
      if cmp -s "$temp" "$dest" && [ "$(stat -c %a "$dest")" = 700 ]; then
        rm -f "$temp"
        trap - 0 1 2 15
        return 0
      fi
      install -d -m 700 "$home_dir/.local/bin"
      staged=$(mktemp "$home_dir/.local/bin/.${name%.ts}.XXXXXX")
      trap 'rm -f "$temp" "$staged"' 0 1 2 15
      install -m 700 "$temp" "$staged"
      mv "$staged" "$dest"
      rm -f "$temp"
      trap - 0 1 2 15
      ;;
    *)
      install -d -m 700 "$home_dir/.local/bin"
      install -m 700 "$repo_dir/bin/$name" "$home_dir/.local/bin/$name"
      ;;
  esac
}

install_guidance() {
  install -d -m 700 "$agent_dir"
  temp=$(mktemp "$agent_dir/.$guidance_file.XXXXXX")
  trap 'rm -f "$temp"' 0 1 2 15
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = "$marker" ]; then
      for name in $guidance; do
        cat "$repo_dir/guidance/$name.md"
        printf '\n'
      done
    else
      printf '%s\n' "$line"
    fi
  done < "$guidance_source" > "$temp"
  chmod 600 "$temp"
  mv "$temp" "$agent_dir/$guidance_file"
  trap - 0 1 2 15
}

validate_skills
validate_guidance
validate_bins
validate_audio_sandbox
validate_session_backup

if [ "$check" = 1 ]; then
  exit 0
fi

for name in design-check review-check foundation-check story-deletion-check semantic-check; do
  destination="$home_dir/.local/bin/$name"
  if [ -f "$destination" ] && grep -Fq ": owned standalone launcher (misty-step/harness)." "$destination"; then
    rm -f -- "$destination"
  fi
done
# Retire the optional resource launcher and its owned limits without stopping
# running services. Native Herdr owns starts; desktop configuration is untouched.
guard="$home_dir/.local/bin/desktop-guard"
if [ -f "$guard" ] && grep -Fq '# owned by misty-step/harness agent-config desktop-guard' "$guard"; then
  rm -f -- "$guard"
fi
for name in dev.slice dev-fleet.slice dev-exec.slice; do
  unit="$home_dir/.config/systemd/user/$name"
  if [ -f "$unit" ] && grep -Fqx '# owned by misty-step/harness agent-config desktop-guard' "$unit"; then
    systemctl --user set-property --runtime "$name" MemoryMax=infinity MemoryHigh=infinity MemorySwapMax=infinity
    rm -f -- "$unit"
    systemctl --user daemon-reload
  fi
done
for name in $skill_list; do
  install_skill "$name"
  retired=
  case "$name" in
    engineering-operations)
      retired='agent-ergonomics capture' ;;
    cloudflare-workers)
      retired=wrangler ;;
    remote-execution)
      retired=using-exe-dev ;;
    design-studio)
      retired='frontend-design show-me herdr' ;;
    sachstand)
      retired=decide ;;
    story-qa)
      retired='check-cadence verification-infrastructure' ;;
  esac
  for old in $retired; do
    destination="$agent_dir/skills/$old"
    if [ "$preserve_foreign_skills" = 0 ] || owns_skill "$destination"; then
      rm -rf -- "$destination"
    fi
  done
done
for name in $bins; do install_bin "$name"; done
if [ -n "$guidance" ]; then install_guidance; fi
if [ "$audio_sandbox" = 1 ]; then bun "$repo_dir/audio-sandbox/install.ts" host --home "$home_dir"; fi
if [ "$session_backup" = 1 ]; then install_session_backup; fi
