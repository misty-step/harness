#!/usr/bin/env python3
# owned by misty-step/harness agent-config workstation-guard
"""PreToolUse hook for Claude Code and Codex: refuse host-affecting shell commands on workstations.

Reads the native hook JSON on stdin. Exit 2 with the reason on stderr blocks the
call in both harnesses. Every other outcome (other tools, other hosts, unparsable
input, no match) allows it silently. The command is parsed, not grepped: quoted
text such as a commit message, `echo` argument or `grep` pattern is not a command.
Residual risk: commands built at run time (`$cmd`, a script file, compose files)
are invisible, and a refused flag used as a real argument of the container's own
command (`docker run img prog --privileged`) is refused.
"""
import fnmatch
import json
import os
import re
import socket
import sys

HOSTS = ('mirrodin', 'serenity', 'nassau')
ALTERNATIVE = (
    'Workstations are not disposable. Run this on a disposable exe.dev VM (skill `remote-execution`, '
    '`ssh exe.dev new ...`) or the Hetzner box (`ssh hetzner-ci`) instead; see the remote-first '
    'execution section of the workstation guidance.'
)

WRAPPERS = {  # name -> options that take a value
    'sudo': set('-u -g -C -D -h -p -r -t -U -T -R'.split()), 'doas': {'-u', '-C'},
    'env': {'-u', '-C', '-S'}, 'command': set(), 'exec': {'-a'}, 'builtin': set(), 'nohup': set(),
    'nice': {'-n'}, 'ionice': set('-c -n -p -P -u'.split()), 'time': {'-f', '-o'}, 'setsid': set(),
    'timeout': {'-s', '-k'}, 'stdbuf': set('-i -o -e'.split()), 'chrt': set(), 'taskset': set(),
    'xargs': set('-a -d -E -I -L -n -P -s'.split()), 'watch': {'-n', '-d'}, 'unbuffer': set(),
}
POSITIONAL_AFTER_OPTIONS = {'timeout': 1, 'taskset': 1, 'chrt': 1}
SHELLS = {'sh', 'bash', 'zsh', 'dash', 'ksh', 'fish', 'ash'}
KEYWORDS = {'if', 'then', 'else', 'elif', 'while', 'until', 'do', '!', '{', 'time', 'coproc'}

CONTAINER_TOOLS = {'docker', 'podman', 'nerdctl', 'ctr'}
LXD_TOOLS = {'incus', 'lxc'}
INIT_COMMANDS = {'/sbin/init', '/usr/sbin/init', '/lib/systemd/systemd', '/usr/lib/systemd/systemd', 'systemd'}
HARMLESS_DEVICES = {'/dev/null', '/dev/zero', '/dev/random', '/dev/urandom', '/dev/shm', '/dev/stdin',
                    '/dev/stdout', '/dev/stderr', '/dev/fd'}
LXD_HOST_DEVICES = {'gpu', 'usb', 'pci', 'unix-char', 'unix-block', 'unix-hotplug', 'tpm', 'infiniband'}

POWER_COMMANDS = {'reboot', 'shutdown', 'poweroff', 'halt', 'kexec', 'pm-suspend', 'pm-hibernate',
                  'omarchy-system-reboot', 'omarchy-system-shutdown', 'omarchy-system-logout'}
POWER_VERBS = {'reboot', 'poweroff', 'halt', 'kexec', 'suspend', 'hibernate', 'hybrid-sleep',
               'suspend-then-hibernate', 'soft-reboot', 'rescue', 'emergency', 'exit', 'isolate'}
POWER_TARGETS = {'reboot.target', 'poweroff.target', 'halt.target', 'kexec.target', 'suspend.target',
                 'hibernate.target', 'rescue.target', 'emergency.target'}
STOP_VERBS = {'restart', 'stop', 'kill', 'try-restart', 'reload-or-restart', 'try-reload-or-restart'}
SESSION_UNITS = ('display-manager', 'sddm', 'gdm', 'gdm3', 'lightdm', 'greetd', 'lxdm', 'xdm', 'slim', 'ly',
                 'emptty', 'plasmalogin', 'cosmic-greeter', 'user@*', 'user-runtime-dir@*', 'getty@*',
                 'serial-getty@*', 'autovt@*', 'getty', 'systemd-logind', 'wayland-wm@*',
                 'graphical.target', 'graphical-session.target', 'multi-user.target')
SYSTEMCTL_VALUE_OPTIONS = {'-t', '--type', '-p', '--property', '-s', '--signal', '-n', '--lines', '-o',
                           '--output', '--state', '--kill-whom', '--root', '--job-mode', '-M', '-H'}
LOGINCTL_VERBS = {'terminate-session', 'terminate-user', 'kill-session', 'kill-user'}


class Refusal(Exception):
    pass


def refuse(reason):
    raise Refusal(reason)


# --- Parsing: shell text -> simple commands ---------------------------------

class Cmd:
    def __init__(self):
        self.argv = []
        self.doc = None  # heredoc body fed to this command


HEREDOC = re.compile(r'<<(-?)[ \t]*(?:\'([^\']*)\'|"([^"]*)"|([^\s;&|()<>]+))')


def scan(text, i, out, closer=None):
    """Append the simple commands in text[i:] to out; return where scanning stopped.

    Command substitutions ($(...) and backticks) become commands of their own.
    """
    n, cur, word, has_word = len(text), Cmd(), [], False
    pending, depth = [], 0

    def end_word():
        nonlocal word, has_word
        if has_word:
            cur.argv.append(''.join(word))
        word, has_word = [], False

    def end_cmd():
        nonlocal cur
        end_word()
        if cur.argv:
            out.append(cur)
        cur = Cmd()

    while i < n:
        c = text[i]
        if c == '\\':
            if text[i + 1:i + 2] != '\n':
                word.append(text[i + 1:i + 2])
                has_word = True
            i += 2
        elif c == "'":
            j = text.find("'", i + 1)
            j = n if j < 0 else j
            word.append(text[i + 1:j])
            has_word, i = True, j + 1
        elif c == '"':
            i, has_word = double_quoted(text, i + 1, out, word), True
        elif c == '$' and text[i + 1:i + 2] == '(':
            i = scan(text, i + 2, out, ')')
        elif c == '`':
            if closer == '`':
                end_cmd()
                return i + 1
            i = scan(text, i + 1, out, '`')
        elif c == '#' and not has_word:
            j = text.find('\n', i)
            i = n if j < 0 else j
        elif c == '<' and text.startswith('<<', i) and text[i + 2:i + 3] != '<' and HEREDOC.match(text, i):
            m = HEREDOC.match(text, i)
            pending.append((m.group(2) or m.group(3) or m.group(4), bool(m.group(1)), cur))
            i = m.end()
        elif c in ';&|\n()':
            if c == ')' and closer == ')':
                if depth == 0:
                    end_cmd()
                    return i + 1
                depth -= 1
            elif c == '(' and closer == ')':
                depth += 1
            end_cmd()
            i += 1
            if c == '\n':
                i = take_heredocs(text, i, pending)
        elif c in ' \t\r':
            end_word()
            i += 1
        else:
            word.append(c)
            has_word = True
            i += 1
    end_cmd()
    return n


def double_quoted(text, i, out, word):
    n = len(text)
    while i < n:
        c = text[i]
        if c == '"':
            return i + 1
        if c == '\\' and text[i + 1:i + 2] in ('"', '\\', '$', '`', '\n'):
            word.append('' if text[i + 1] == '\n' else text[i + 1])
            i += 2
        elif c == '$' and text[i + 1:i + 2] == '(':
            i = scan(text, i + 2, out, ')')
        elif c == '`':
            i = scan(text, i + 1, out, '`')
        else:
            word.append(c)
            i += 1
    return n


def take_heredocs(text, i, pending):
    for delim, strip, owner in pending:
        body = []
        while i < len(text):
            j = text.find('\n', i)
            line = text[i:] if j < 0 else text[i:j]
            i = len(text) if j < 0 else j + 1
            if (line.lstrip('\t') if strip else line) == delim:
                break
            body.append(line)
        owner.doc = '\n'.join(body)
    pending.clear()
    return i


def commands(text):
    out = []
    scan(text, 0, out)
    return out


# --- Policy ------------------------------------------------------------------

def option_values(args, *names):
    for k, a in enumerate(args):
        for name in names:
            if a == name and k + 1 < len(args):
                yield args[k + 1]
            elif a.startswith(name + '='):
                yield a[len(name) + 1:]


def host_device(path):
    path = os.path.normpath(path)
    return (path == '/dev' or path.startswith('/dev/')) and path not in HARMLESS_DEVICES


def volume_sources(args):
    for k, a in enumerate(args):
        spec = None
        if a in ('-v', '--volume') and k + 1 < len(args):
            spec = args[k + 1]
        elif a.startswith('--volume='):
            spec = a[len('--volume='):]
        elif a.startswith('-v') and not a.startswith('--') and len(a) > 2:
            spec = a[2:]
        if spec is not None:
            yield spec.split(':')[0]
    for value in option_values(args, '--mount'):
        for part in value.split(','):
            key, _, source = part.partition('=')
            if key in ('src', 'source'):
                yield source


def check_container(args):
    if any(a in ('--privileged', '--privileged=true') for a in args):
        refuse('a privileged container (--privileged)')
    if any(a == '--device' or a.startswith('--device=') for a in args):
        refuse('host device passthrough to a container (--device)')
    for flag in ('--pid', '--ipc', '--userns', '--uts'):
        if 'host' in option_values(args, flag):
            refuse(f'a container in the host namespace ({flag}=host)')
    if {'always', 'true'} & set(option_values(args, '--systemd')):
        refuse('systemd in a container (--systemd=always)')
    if any(a in INIT_COMMANDS for a in args) or INIT_COMMANDS & set(option_values(args, '--entrypoint')):
        refuse('an init system in a container (/sbin/init or systemd as the command)')
    if 'security.insecure' in option_values(args, '--allow'):
        refuse('an insecure (privileged) image build (--allow security.insecure)')
    for source in volume_sources(args):
        if host_device(source):
            refuse(f'a host device mounted into a container ({source})')


def check_lxd(args):
    if any('security.privileged=true' in a for a in args):
        refuse('a privileged container (security.privileged=true)')
    subcommands = [a for a in args if not a.startswith('-')][:3]
    if subcommands[:1] in (['launch'], ['init'], ['create']) and any(
            a in ('-d', '--device') or a.startswith('--device=') for a in args):
        refuse('host device passthrough to a container (--device)')
    if subcommands[:3] in (['config', 'device', 'add'], ['config', 'device', 'override']) or subcommands[:2] == ['device', 'add']:
        if any(a in LXD_HOST_DEVICES or host_device(a.partition('source=')[2] or a) for a in args):
            refuse('host device passthrough to a container (device add)')


def check_nspawn(args):
    if any(a in ('-b', '--boot') for a in args):
        refuse('systemd in a container (systemd-nspawn --boot)')
    for value in list(option_values(args, '--bind', '--bind-ro', '--capability')):
        if value.split(':')[0] == 'all' or host_device(value.split(':')[0]):
            refuse(f'host access from a container ({value})')


def check_qemu(args):
    for a in args:
        if re.search(r'vfio-pci|usb-host|pci-assign', a):
            refuse('host device passthrough to a VM')
        for path in re.findall(r'/dev/[^,\s]*', a):
            if host_device(path):
                refuse(f'a host device given to a VM ({path})')


def check_systemctl(args):
    if any(a in ('-H', '--host', '-M', '--machine') or a.startswith(('--host=', '--machine=')) for a in args):
        return  # another host or a container, not this workstation
    positional, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a.startswith('-'):
            skip = a in SYSTEMCTL_VALUE_OPTIONS
        else:
            positional.append(a)
    if not positional:
        return
    verb, units = positional[0], positional[1:]
    if verb in POWER_VERBS:
        refuse(f'systemctl {verb}, which changes the workstation power or unit state')
    if set(units) & POWER_TARGETS:
        refuse('a power state change (' + ', '.join(sorted(set(units) & POWER_TARGETS)) + ')')
    if verb in STOP_VERBS:
        for unit in units:
            if session_unit(unit):
                refuse(f'{verb} of the display or session unit {unit}')


def session_unit(unit):
    names = {unit, unit[:-len('.service')] if unit.endswith('.service') else unit}
    return any(fnmatch.fnmatch(name, pattern) for name in names for pattern in SESSION_UNITS)


def check_kill(args):
    targets, skip = [], False
    for k, a in enumerate(args):
        if skip:
            skip = False
        elif a in ('-s', '-n', '--signal'):
            skip = True
        elif a == '--' or (k == 0 and a.startswith('-')):
            continue
        else:
            targets.append(a)
    if {'0', '-1', '1'} & set(targets):
        refuse('kill of a process group, every process or init (kill 0, -1 or 1)')


def check_service(args):
    positional = [a for a in args if not a.startswith('-')]
    if len(positional) >= 2 and positional[1] in ('restart', 'stop') and session_unit(positional[0]):
        refuse(f'{positional[1]} of the display or session service {positional[0]}')


def shell_script(args):
    for k, a in enumerate(args):
        if a == '--command' or (a.startswith('-') and not a.startswith('--') and 'c' in a[1:] and a[1:].isalpha()):
            return args[k + 1] if k + 1 < len(args) else None
    return None


def unwrap(name, args):
    if name == 'command' and any(a in ('-v', '-V') for a in args):
        return []
    values, i = WRAPPERS[name], 0
    while i < len(args):
        a = args[i]
        if a == '--':
            i += 1
            break
        if a.startswith('-') and len(a) > 1:
            i += 2 if a in values else 1
        elif name in ('sudo', 'env', 'doas') and re.match(r'[A-Za-z_]\w*=', a):
            i += 1
        else:
            break
    return args[i + POSITIONAL_AFTER_OPTIONS.get(name, 0):]


def without_redirects(argv):
    words, skip = [], False
    for k, word in enumerate(argv):
        if skip:
            skip = False
        elif re.fullmatch(r'\d*(>>?|<)', word) and k + 1 < len(argv):
            if argv[k + 1] == '/proc/sysrq-trigger':
                refuse('a write to /proc/sysrq-trigger')
            skip = True
        elif re.match(r'\d*[<>]', word):
            if re.fullmatch(r'\d*>>?/proc/sysrq-trigger', word):
                refuse('a write to /proc/sysrq-trigger')
        else:
            words.append(word)
    return words


def examine(cmd, depth=0):
    if depth > 8:
        return
    argv = without_redirects(cmd.argv)
    while argv and (argv[0] in KEYWORDS or re.match(r'[A-Za-z_]\w*=', argv[0])):
        argv = argv[1:]
    if not argv:
        return
    name, args = os.path.basename(argv[0]), argv[1:]
    if name in WRAPPERS:
        return examine_words(unwrap(name, args), cmd.doc, depth)
    if name in SHELLS or name == 'su':
        script = shell_script(args)
        if script is not None:
            return examine_text(script, depth + 1)
        if cmd.doc is not None and name in SHELLS:
            return examine_text(cmd.doc, depth + 1)
        return
    if name == 'eval':
        return examine_text(' '.join(args), depth + 1)
    if name in ('pkill', 'killall', 'killall5', 'skill'):
        refuse(f'{name}, which kills processes by name; stop only a process you started, by its exact PID')
    if name == 'tee' and '/proc/sysrq-trigger' in args:
        refuse('a write to /proc/sysrq-trigger')
    if name == 'kill':
        check_kill(args)
    elif name in POWER_COMMANDS or (name in ('init', 'telinit') and args[:1] in (['0'], ['6'])):
        refuse(f'{name}, which changes the workstation power state')
    elif name == 'systemctl':
        check_systemctl(args)
    elif name == 'service':
        check_service(args)
    elif name == 'loginctl':
        if LOGINCTL_VERBS & {a for a in args if not a.startswith('-')}:
            refuse('loginctl ' + sorted(LOGINCTL_VERBS & set(args))[0])
    elif name == 'uwsm' and args[:1] == ['stop']:
        refuse('uwsm stop (ends the session)')
    elif name == 'hyprctl' and 'dispatch' in args and 'exit' in args[args.index('dispatch'):]:
        refuse('hyprctl dispatch exit (ends the compositor)')
    elif name in CONTAINER_TOOLS:
        check_container(args)
    elif name in LXD_TOOLS:
        check_lxd(args)
    elif name == 'systemd-nspawn':
        check_nspawn(args)
    elif name.startswith('qemu') or name == 'kvm':
        check_qemu(args)


def examine_words(argv, doc, depth):
    if argv:
        cmd = Cmd()
        cmd.argv, cmd.doc = argv, doc
        examine(cmd, depth + 1)


def examine_text(text, depth=0):
    for cmd in commands(text):
        examine(cmd, depth)


# --- Hook entry point --------------------------------------------------------

def guarded_host():
    configured = os.environ.get('WORKSTATION_GUARD_HOSTS')
    hosts = HOSTS if configured is None else tuple(re.split(r'[\s,]+', configured.strip().lower()))
    return socket.gethostname().split('.')[0].lower() in hosts


def main():
    try:
        data = json.load(sys.stdin)
        if data.get('tool_name') != 'Bash':
            return 0
        command = data['tool_input']['command']
        if isinstance(command, list):
            command = ' '.join(str(part) for part in command)
        if not isinstance(command, str) or not guarded_host():
            return 0
        examine_text(command)
    except Refusal as refusal:
        shown = ' '.join(command.split())
        print(f'workstation-guard: refused on {socket.gethostname()}: {refusal}.\n'
              f'Command: {shown[:200]}{"..." if len(shown) > 200 else ""}\n{ALTERNATIVE}', file=sys.stderr)
        return 2
    except Exception:  # Fail open: a guard bug must not stop unrelated work.
        return 0
    return 0


if __name__ == '__main__':
    sys.exit(main())
