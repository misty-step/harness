#!/usr/bin/env python3
# owned by misty-step/harness agent-config t3-agent
"""Drive T3 through an existing Fleet catalog or native Claude MCP profile."""
import argparse
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

if sys.version_info < (3, 11):
    print(json.dumps({"error": "python-runtime: t3-agent requires Python 3.11 or newer; put the supported interpreter on PATH (on macOS, include /opt/homebrew/bin before /usr/bin)"}), file=sys.stderr)
    sys.exit(2)

import tomllib
import urllib.error
import urllib.parse
import urllib.request


class AccessError(Exception):
    pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def credential(server):
    if "claude_profile" not in server:
        value = os.environ.get(server["token_env"], "").strip()
        if not value:
            raise AccessError("credential-missing: configured environment value is empty")
        return value.splitlines()[0]
    try:
        path = Path(server["claude_profile"]) / ".credentials.json"
        cache = json.loads(path.read_text())["mcpOAuth"]
        matches = [entry["accessToken"] for entry in cache.values()
                   if entry.get("serverName") == server["id"] and entry.get("serverUrl") == server["url"]]
        if len(matches) != 1 or not isinstance(matches[0], str) or not matches[0].strip():
            raise ValueError()
        token = matches[0].strip()
        if any(character.isspace() for character in token):
            raise ValueError()
        return token
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        raise AccessError("native-credential-missing: select an existing authenticated MCP profile; no login or refresh was attempted") from None


def http_failure(code):
    hint = {401: "credential rejected; check expiry", 403: "credential lacks permission",
            404: "MCP endpoint or session not found"}.get(code, "request rejected")
    return AccessError(f"http-{code}: {hint}; no operation was retried")


class Client:
    def __init__(self, server):
        self.url = server["url"]
        self.token = credential(server)
        self.proxy = server.get("socks_proxy")
        self.session = None
        self.sequence = 0
        self.open = urllib.request.build_opener(NoRedirect()).open
        self.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                               "clientInfo": {"name": "t3-agent", "version": "1"}})
        self.rpc("notifications/initialized", {}, notify=True)

    def curl(self, payload, headers):
        # Curl configuration goes over stdin so neither the process list nor a file holds the credential.
        def quoted(value):
            return json.dumps(value)
        config = "\n".join(["url = " + quoted(self.url), 'request = "POST"',
                             "data = " + quoted(json.dumps(payload))] +
                            ["header = " + quoted(key + ": " + value) for key, value in headers.items()])
        try:
            result = subprocess.run(["curl", "--silent", "--show-error", "--include", "--max-time", "30",
                                     "--socks5-hostname", self.proxy, "--max-filesize", "16777216", "--config", "-"],
                                    input=config, capture_output=True, text=True, timeout=35)
        except (OSError, subprocess.TimeoutExpired):
            raise AccessError("proxy-unreachable: check curl and the configured SOCKS proxy; write outcome may be unknown") from None
        if result.returncode:
            raise AccessError(f"proxy-unreachable: curl exit {result.returncode}; check SOCKS proxy and T3 endpoint; write outcome may be unknown")
        raw = result.stdout
        try:
            while raw.startswith("HTTP/"):
                header, separator, raw = raw.partition("\r\n\r\n") if "\r\n\r\n" in raw else raw.partition("\n\n")
                if not separator:
                    raise ValueError()
                lines = header.splitlines()
                status = int(lines[0].split()[1])
                if status >= 300:
                    raise http_failure(status)
                for line in lines[1:]:
                    key, separator, value = line.partition(":")
                    if key.lower() == "mcp-session-id" and separator:
                        self.session = value.strip()
            return raw
        except (ValueError, IndexError):
            raise AccessError("invalid-proxy-response: inspect the configured SOCKS transport") from None

    def rpc(self, method, params, notify=False):
        self.sequence += 1
        payload = {"jsonrpc": "2.0", "method": method, "params": params}
        if not notify:
            payload["id"] = self.sequence
        headers = {"Authorization": "Bearer " + self.token, "Content-Type": "application/json",
                   "Accept": "application/json, text/event-stream", "MCP-Protocol-Version": "2025-06-18"}
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        if self.proxy:
            raw = self.curl(payload, headers)
        else:
            request = urllib.request.Request(self.url, data=json.dumps(payload).encode(), headers=headers)
            try:
                with self.open(request, timeout=30) as response:
                    self.session = response.headers.get("Mcp-Session-Id", self.session)
                    raw = response.read(16 * 1024 * 1024).decode()
            except urllib.error.HTTPError as error:
                raise http_failure(error.code) from None
            except (urllib.error.URLError, TimeoutError, OSError):
                raise AccessError("unreachable: check host, tailnet and T3 service; outcome may be unknown; do not repeat writes blindly") from None
        if notify or not raw.strip():
            return None
        try:
            frames = [json.loads(raw)] if raw.lstrip().startswith("{") else [
                json.loads(line[5:]) for line in raw.splitlines() if line.startswith("data:")]
            reply = next(frame for frame in frames if frame.get("id") == self.sequence)
            if "error" in reply:
                raise AccessError(f"rpc-{reply['error'].get('code')}: T3 rejected the request")
            return reply["result"]
        except (ValueError, KeyError, StopIteration, TypeError):
            raise AccessError("invalid-response: outcome may be unknown; inspect the thread before retrying") from None

    def call(self, name, arguments):
        result = self.rpc("tools/call", {"name": name, "arguments": arguments})
        value = result.get("structuredContent")
        if value is None:
            texts = [part["text"] for part in result.get("content", []) if part.get("type") == "text"]
            try:
                value = json.loads(texts[0]) if len(texts) == 1 else result
            except ValueError:
                value = result
        if result.get("isError"):
            # Return T3's error to the caller, but never transport headers or the credential.
            detail = json.dumps(value).replace(self.token, "<redacted>")
            raise AccessError("tool-rejected: " + detail)
        return value


def catalog(path, claude_profile=None):
    try:
        if claude_profile:
            profile = str(Path(claude_profile).expanduser())
            config = json.loads((Path(profile) / ".claude.json").read_text())["mcpServers"]
            servers = [{"id": name, "url": entry["url"], "claude_profile": profile}
                       for name, entry in config.items() if entry.get("type") in {"http", "sse"}]
        else:
            with open(path, "rb") as handle:
                servers = tomllib.load(handle)["servers"]
        for server in servers:
            url = urllib.parse.urlsplit(server["url"])
            if url.username or url.password or url.query or url.fragment:
                raise ValueError()
            if url.scheme != "https" and not (url.scheme == "http" and url.hostname in {"127.0.0.1", "localhost", "::1"}):
                raise ValueError()
            if not server["id"] or ("claude_profile" not in server and not server["token_env"]):
                raise ValueError()
        if not servers or len({s["id"] for s in servers}) != len(servers):
            raise ValueError()
        return servers
    except (OSError, ValueError, KeyError, TypeError):
        raise AccessError("invalid-catalog: provide a Fleet TOML catalog or native Claude HTTP MCP profile with unique server IDs and HTTPS URLs") from None


def credentials(servers):
    missing = [s for s in servers if "token_env" in s and not os.environ.get(s["token_env"], "").strip()]
    if not missing:
        return
    if os.environ.get("T3_AGENT_INJECTED") or any(not s.get("token_pass") for s in missing):
        raise AccessError("credential-missing: supply the configured environment variable or existing pass reference; never mint a token as recovery")
    command = ["pass-env", "run"]
    for server in missing:
        command += ["-e", server["token_env"] + "=" + server["token_pass"]]
    command += ["--", sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]]
    os.environ["T3_AGENT_INJECTED"] = "1"
    try:
        os.execvp(command[0], command)
    except OSError:
        raise AccessError("pass-env-unavailable: use the authenticated-commands skill to load an existing credential") from None


def check(servers, config_path):
    rows = []
    for server in servers:
        row = {"server": server["id"], "url": server["url"], "ok": False}
        try:
            if "token_env" in server and not os.environ.get(server["token_env"], "").strip():
                if os.environ.get("T3_AGENT_CHECK_INJECTED") == server["id"]:
                    raise AccessError("credential-load-failed: configured pass reference supplied no value")
                if not server.get("token_pass"):
                    raise AccessError("credential-missing: no existing environment value or pass reference")
                command = ["pass-env", "run", "-e", server["token_env"] + "=" + server["token_pass"],
                           "--", sys.executable, str(Path(__file__).resolve()), "--config", config_path,
                           "--server", server["id"]]
                if server.get("socks_proxy"):
                    command += ["--socks-proxy", server["socks_proxy"]]
                command += ["check"]
                try:
                    child = subprocess.run(command, capture_output=True, text=True, timeout=90,
                                           env={**os.environ, "T3_AGENT_CHECK_INJECTED": server["id"]})
                    report = json.loads(child.stdout)
                    child_row = report["servers"][0]
                    if child_row["server"] != server["id"]:
                        raise ValueError()
                    row.update(child_row)
                except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired):
                    raise AccessError("credential-load-failed: existing pass reference could not run the authenticated check") from None
                rows.append(row)
                continue
            client = Client(server)
            environment = client.call("t3_environment_read", {})
            client.call("t3_project_list", {"limit": 1})
            row.update(ok=True, version=environment.get("serverVersion"))
        except AccessError as error:
            row["error"] = str(error)
        rows.append(row)
    return {"observedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(), "servers": rows}


def notify(result, path, report_url):
    previous = {}
    if path.exists():
        try:
            previous = json.loads(path.read_text())
        except (OSError, ValueError):
            raise AccessError("invalid-health-state: preserve and inspect the previous state before replacing it") from None
    current = {row["server"]: {key: row.get(key) for key in ("ok", "error")} for row in result["servers"]}
    changes = [row for row in result["servers"] if previous.get(row["server"]) != current[row["server"]]]
    for row in changes:
        if row["ok"] and row["server"] not in previous:
            continue
        status = "recovered" if row["ok"] else "failed: " + row["error"]
        body = f"T3 access on {row['server']} {status}. Checked {result['observedAt']}. Review [access evidence]({report_url}).\n"
        try:
            sent = subprocess.run(["home", "post", "--from", "T3-access"], input=body, text=True,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            sent = None
        if sent is None or sent.returncode:
            inbox = Path.home() / ".local/state/home/inbox.md"
            inbox.parent.mkdir(parents=True, exist_ok=True)
            with inbox.open("a") as handle:
                handle.write(f"\n## {result['observedAt']} [T3-access]\n\n{body}")
            print("home-post-failed: wrote the access report to Home's inbox", file=sys.stderr)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(current, handle)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default=str(Path.home() / ".config/fleet/config.toml"))
    parser.add_argument("--claude-profile", help="read an existing Claude HTTP MCP profile and its OAuth cache in place")
    parser.add_argument("--socks-proxy", help="existing SOCKS5 host:port; curl receives credentials only on stdin")
    parser.add_argument("--server", help="exact server ID from the catalog")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("servers", help="list configured endpoints without reading credentials")
    commands.add_parser("tools", help="discover the selected server's live MCP tool schemas")
    call = commands.add_parser("call", help="call a tool once; JSON arguments, @file or @- for stdin")
    call.add_argument("tool")
    call.add_argument("arguments", nargs="?", default="{}")
    health = commands.add_parser("check", help="read-only authenticated checks; all configured servers by default")
    health.add_argument("--notify", action="store_true", help="post failures and recovery transitions to Home")
    health.add_argument("--state", default=str(Path.home() / ".local/state/t3-agent/health.json"))
    health.add_argument("--report-url", help="review URL included in Home notifications")
    args = parser.parse_args()
    if args.command == "check" and args.notify and not args.report_url:
        raise AccessError("report-url-required: Home notifications need an accessible evidence link")
    if args.socks_proxy:
        try:
            proxy = urllib.parse.urlsplit("socks5://" + args.socks_proxy)
            if not proxy.hostname or not proxy.port or proxy.username or proxy.password or proxy.path or proxy.query or proxy.fragment:
                raise ValueError()
        except ValueError:
            raise AccessError("invalid-proxy: supply SOCKS5 host:port without credentials or a path") from None
    servers = catalog(Path(args.config).expanduser(), args.claude_profile)
    for server in servers:
        server["socks_proxy"] = args.socks_proxy
    if args.server:
        servers = [s for s in servers if s["id"] == args.server]
        if not servers:
            raise AccessError("unknown-server: run t3-agent servers")
    if args.command == "servers":
        return [{"id": s["id"], "url": s["url"]} for s in servers], 0
    if args.command != "check" and len(servers) != 1:
        raise AccessError("server-required: select one catalog ID with --server")
    if args.command == "check":
        result = check(servers, args.config)
        if args.notify:
            notify(result, Path(args.state).expanduser(), args.report_url)
        return result, int(any(not row["ok"] for row in result["servers"]))
    credentials(servers)
    if args.command == "tools":
        return Client(servers[0]).rpc("tools/list", {}), 0
    source = args.arguments
    if source.startswith("@"):
        source = sys.stdin.read() if source == "@-" else Path(source[1:]).read_text()
    try:
        arguments = json.loads(source)
        if not isinstance(arguments, dict):
            raise ValueError()
    except ValueError:
        raise AccessError("invalid-arguments: supply one JSON object, @file or @-; no request was sent") from None
    return Client(servers[0]).call(args.tool, arguments), 0


if __name__ == "__main__":
    try:
        value, code = main()
        print(json.dumps(value, indent=2))
        sys.exit(code)
    except (AccessError, OSError) as error:
        print(json.dumps({"error": str(error)}), file=sys.stderr)
        sys.exit(1)
