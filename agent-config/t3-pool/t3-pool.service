# owned by misty-step/harness t3-pool
[Unit]
Description=Continue usage-limited T3 threads on another account
ConditionPathExists=%h/.t3/userdata/statev2.sqlite
ConditionPathExists=%h/.t3/userdata/server-runtime.json

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/t3-pool
UMask=0077
TimeoutStartSec=5min
KillMode=mixed
TimeoutStopSec=45s
