#!/bin/sh
set -eu
umask 077

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=${PI_CODING_AGENT_DIR:-$(omp config path)}
base_dir=${AGENT_CONFIG_DIR:-$repo_dir/../agent-config}
local_config=${OMP_CONFIG_LOCAL_CONFIG:-$HOME/.config/harness/omp.yml}

# No arguments: selection is by environment, and repository hooks are owned by
# the monorepo root (scripts/bootstrap), not by this installer.
[ "$#" -eq 0 ] || {
  echo 'install takes no arguments; select components with OMP_INSTALL_COMPONENTS' >&2
  exit 1
}

require_bun() {
  command -v bun >/dev/null 2>&1 || { echo "bun is required" >&2; exit 1; }
}

require_jq() {
  command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }
}

require_nonempty() {
  [ -s "$1" ] || {
    printf 'Missing or empty source: %s\n' "$1" >&2
    exit 1
  }
}

require_base() {
  [ -f "$base_dir/install" ] || {
    printf 'agent-config installer not found at %s; set AGENT_CONFIG_DIR\n' "$base_dir" >&2
    exit 1
  }
}

# Shared primitives — skills, guidance sections, and the pass-env launcher —
# deploy from agent-config through its single contract. Pass no flags to skip.
run_shared() {
  mode=
  if [ "${1-}" = --check ]; then mode=--check; shift; fi
  [ $# -gt 0 ] || return 0
  "$base_dir/install" $mode --agent-dir "$agent_dir" "$@"
}

guidance_files='AGENTS.md OPERATIONS.md WATCHDOG.md WATCHDOG.yml'

validate_guidance() {
  for file in $guidance_files; do
    require_nonempty "$repo_dir/global/$file"
  done
  require_base
  run_shared --check \
    --bin design-check.ts --bin story-deletion-check.ts \
    --guidance engineering --guidance workstation \
    --guidance-source "$repo_dir/global/AGENTS.md"
}
install_guidance() {
  install -d -m 700 "$agent_dir"
  for file in OPERATIONS.md WATCHDOG.md WATCHDOG.yml; do
    install -m 600 "$repo_dir/global/$file" "$agent_dir/$file"
  done
  rm -f -- "$agent_dir/RULES.md"
  run_shared \
    --bin design-check.ts --bin story-deletion-check.ts \
    --guidance engineering --guidance workstation \
    --guidance-source "$repo_dir/global/AGENTS.md"
}
validate_config() {
  require_bun
  require_nonempty "$repo_dir/config.yml"
  require_nonempty "$repo_dir/models.yml"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/config.yml" --local "$local_config" --dest "$agent_dir/config.yml" --check
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/models.yml" --dest "$agent_dir/models.yml" --check
  # Validate the effective overlay before touching live config, including
  # foreign model roles and chains that the installer preserves.
  (
    mkdir -p "$HOME/.cache/tmp"
    candidate=$(mktemp -d "$HOME/.cache/tmp/omp-model-policy.XXXXXX")
    trap 'rm -rf -- "$candidate"' 0 1 2 15
    if [ -f "$agent_dir/config.yml" ]; then
      cp "$agent_dir/config.yml" "$candidate/config.yml"
    fi
    bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/config.yml" --local "$local_config" --dest "$candidate/config.yml"
    case ${OMP_MODEL_PROBE-0} in
      0) bun "$repo_dir/bin/omp-model-policy.ts" --config "$candidate/config.yml" ;;
      1) bun "$repo_dir/bin/omp-model-policy.ts" --config "$candidate/config.yml" --probe ;;
      *) echo 'OMP_MODEL_PROBE must be 0 or 1' >&2; exit 1 ;;
    esac
  )
  require_base
  run_shared --check --bin openrouter-key.ts
  require_nonempty "$repo_dir/secrets.yml"
  bun "$repo_dir/bin/omp-secrets-policy.ts" --source "$repo_dir/secrets.yml" --dest "$agent_dir/secrets.yml" --check
}

install_config() {
  install -d -m 700 "$agent_dir"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/config.yml" --local "$local_config" --dest "$agent_dir/config.yml"
  bun "$repo_dir/bin/omp-merge-config.ts" --source "$repo_dir/models.yml" --dest "$agent_dir/models.yml"
  run_shared --bin openrouter-key.ts
  bun "$repo_dir/bin/omp-secrets-policy.ts" --source "$repo_dir/secrets.yml" --dest "$agent_dir/secrets.yml"
}

validate_mcp() {
  require_jq
  require_nonempty "$repo_dir/mcp.json"
  jq empty "$repo_dir/mcp.json" >/dev/null
  if [ -f "$agent_dir/mcp.json" ]; then
    jq empty "$agent_dir/mcp.json" >/dev/null
  fi
}

install_mcp() {
  install -d -m 700 "$agent_dir"
  mcp_target="$agent_dir/mcp.json"
  if [ -f "$mcp_target" ]; then
    temp=$(mktemp "$agent_dir/.mcp.json.XXXXXX")
    trap 'rm -f "$temp"' 0 1 2 15
    jq -s '
      .[0] as $policy
      | .[1] as $live
      | $live + $policy
      | .mcpServers = (
          ($live.mcpServers // {})
          + ($policy.mcpServers
            | with_entries(
                . as $server
                | .value += (
                    ($live.mcpServers[$server.key] // {})
                    | {auth, oauth}
                    | with_entries(select(.value != null))
                  )
              ))
        )
      | .disabledServers = (
          (($live.disabledServers // []) + ($policy.disabledServers // []))
          | unique
        )
    ' "$repo_dir/mcp.json" "$mcp_target" > "$temp"
    chmod 600 "$temp"
    mv "$temp" "$mcp_target"
    trap - 0 1 2 15
  else
    install -m 600 "$repo_dir/mcp.json" "$mcp_target"
  fi
}



# Engineering craft only. Management/review packages belong to Kaylee.
engineering_skills='agent-design authenticated-commands cloudflare-workers design-studio engineering-operations foundation pokayoke remote-execution story-qa system-one test-audit typesafe-ai user-stories visual-state-review'
validate_skill() {
  case "${1-}" in
    herdr|pr-preview|session-close|frontend-design|show-me|wrangler|using-exe-dev|all)
      printf 'Not an OMP engineering skill: %s\n' "$1" >&2
      exit 1
      ;;
    ''|*[!a-zA-Z0-9_-]*)
      printf 'Invalid skill name: %s\n' "${1-}" >&2
      exit 1
      ;;
  esac
  require_base
  run_shared --check --skill "$1"
}

install_skill() {
  run_shared --skill "$1"
}

validate_shared() {
  require_base
  set -- --check --bin pass-env.ts --bin openrouter-key.ts --bin design-check.ts --bin foundation-check.ts --bin review-check.ts --bin story-deletion-check.ts
  for skill in $engineering_skills; do set -- "$@" --skill "$skill"; done
  run_shared "$@"
}

install_shared() {
  set -- --bin pass-env.ts --bin openrouter-key.ts --bin design-check.ts --bin foundation-check.ts --bin review-check.ts --bin story-deletion-check.ts
  for skill in $engineering_skills; do set -- "$@" --skill "$skill"; done
  run_shared "$@"
  for skill in pr-preview sachstand session-close decide parlor ast-grep now-next; do
    rm -rf -- "$agent_dir/skills/$skill"
  done
  todoist_owner=${OMP_TODOIST_OWNER:-${OMP_DEVELOPMENT_ROOT:-$HOME/development}/moomooskycow/daybook/.agents/skills/todoist-cli}
  if [ -f "$todoist_owner/SKILL.md" ] && grep -q '[^[:space:]]' "$todoist_owner/SKILL.md" \
    && [ "$(realpath -ms -- "$todoist_owner")" != "$(realpath -ms -- "$agent_dir/skills/todoist-cli")" ]; then
    rm -rf -- "$agent_dir/skills/todoist-cli"
  fi
}

validate_secrets() {
  require_base
  run_shared --check --bin pass-env.ts --skill authenticated-commands
}

install_secrets() {
  run_shared --bin pass-env.ts --skill authenticated-commands
}

validate_agents() {
  for agent_file in "$repo_dir"/agents/*.md; do
    [ -s "$agent_file" ] || continue
    require_nonempty "$agent_file"
  done
}

install_agents() {
  install -d -m 700 "$agent_dir/agents"
  rm -f -- "$agent_dir/agents/executive.md"
  for agent_file in "$repo_dir"/agents/*.md; do
    [ -s "$agent_file" ] || continue
    install -m 600 "$agent_file" "$agent_dir/agents/${agent_file##*/}"
  done
}

validate_themes() {
  require_jq
  found=
  for theme_file in "$repo_dir"/themes/*.json; do
    [ -s "$theme_file" ] || continue
    found=1
    jq empty "$theme_file" >/dev/null
  done
  [ -n "$found" ] || { echo "Missing source themes" >&2; exit 1; }
}

install_themes() {
  install -d -m 700 "$agent_dir/themes"
  rm -f -- "$agent_dir/themes/ember.json" "$agent_dir/themes/ember-dawn.json"
  for theme_file in "$repo_dir"/themes/*.json; do
    [ -s "$theme_file" ] || continue
    install -m 600 "$theme_file" "$agent_dir/themes/${theme_file##*/}"
  done
}

install_extensions() {
  rm -f "$agent_dir/extensions/evidence-packet.ts"
  rm -rf -- "$agent_dir/extensions/executive"
  rm -rf -- "$agent_dir/extensions/continuation-nudge"
  rm -rf -- "$agent_dir/extensions/diff-review"
  rm -rf -- "$agent_dir/references/review"
  rm -f -- "$agent_dir/extensions/loc/git-hook.sh"
  for ext_dir in "$repo_dir"/extensions/*; do
    [ -d "$ext_dir" ] || continue
    ext_name=${ext_dir##*/}
    # audio-sandbox deploys through its own component (install_audio_sandbox).
    case $ext_name in audio-sandbox) continue ;; esac
    install -d -m 700 "$agent_dir/extensions/$ext_name"
    for ext_entry in "$ext_dir"/*; do
      [ -f "$ext_entry" ] || continue
      install -m 700 "$ext_entry" "$agent_dir/extensions/$ext_name/${ext_entry##*/}"
    done
  done
}

# Agent audio sandbox (US-026), two layers. OMP loads the agent .env before any
# tool runs, so the owned block there routes the bash tool even if an extension
# fails to load; the extension extends the contract to process.env children.
# The shared step adds the silent PipeWire sink and Claude Code env, then
# proves live routing when PipeWire is reachable.
validate_audio_sandbox() {
  require_bun
  require_base
  require_nonempty "$repo_dir/extensions/audio-sandbox/index.ts"
  require_nonempty "$base_dir/audio-sandbox/env.ts"
  bun "$base_dir/audio-sandbox/install.ts" dotenv --file "$agent_dir/.env" --check
  run_shared --check --audio-sandbox
}

install_audio_sandbox() {
  # Pokayoke: clean-replace the owned package; materialize the real shared
  # contract over the repo shim so the deployed extension loads self-contained.
  rm -rf -- "$agent_dir/extensions/audio-sandbox"
  install -d -m 700 "$agent_dir/extensions/audio-sandbox"
  install -m 600 "$repo_dir/extensions/audio-sandbox/index.ts" "$agent_dir/extensions/audio-sandbox/index.ts"
  install -m 600 "$base_dir/audio-sandbox/env.ts" "$agent_dir/extensions/audio-sandbox/env.ts"
  bun "$base_dir/audio-sandbox/install.ts" dotenv --file "$agent_dir/.env"
  run_shared --audio-sandbox
}

validate_display_tools() {
  for tool in bwrap slirp4netns Xvfb dbus-run-session; do
    command -v "$tool" >/dev/null 2>&1 || { echo "$tool is required" >&2; exit 1; }
  done
  [ "$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null)" = 0 ] || {
    echo "Engineer display isolation requires dev.tty.legacy_tiocsti=0" >&2; exit 1;
  }
}

validate_cli() {
  command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 1; }
  for name in omp-engineer omp-display omp-gui omp-host-install; do
    source="$repo_dir/bin/$name.py"
    target="$HOME/.local/bin/$name"
    require_nonempty "$source"
    python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' "$source"
    if [ -e "$target" ] || [ -L "$target" ]; then
      [ ! -L "$target" ] && python3 -c \
        'import sys; a = open(sys.argv[1]); b = open(sys.argv[2]); sys.exit(a.readline() + a.readline() != b.readline() + b.readline())' \
        "$source" "$target" || {
        echo "Refusing foreign $name entrypoint" >&2; exit 1;
      }
    fi
  done
  if [ -L "$HOME/.local/bin/omp" ] && [ "$(readlink "$HOME/.local/bin/omp")" = omp-engineer ]; then
    validate_display_tools
  fi
}

validate_engineer_cage() {
  validate_cli
  # Reject a layout cutover before writes when its installed updater has not
  # accepted this versioned contract. The query is inert in Workbench.
  updater="$HOME/.local/bin/workbench-host-update"
  if [ -e "$updater" ] || [ -L "$updater" ]; then
    if ! layouts=$(timeout 5 "$updater" omp-install-layouts) ||
      ! printf '%s\n' "$layouts" | jq -e \
        '.schema_version == 1 and (.layouts | type == "array") and (.layouts | index("harness-engineer-cage-v1") != null)' >/dev/null; then
      echo "Workbench does not support harness-engineer-cage-v1; upgrade its host-update release before activation" >&2
      exit 1
    fi
  fi
  require_nonempty "$repo_dir/units/omp.slice"
  validate_display_tools
  for tool in systemctl systemd-run oomctl; do
    command -v "$tool" >/dev/null 2>&1 || { echo "$tool is required" >&2; exit 1; }
  done
  entry="$HOME/.local/bin/omp"
  native="$HOME/.local/lib/omp-engineer/omp"
  if [ -L "$entry" ]; then
    [ "$(readlink "$entry")" = omp-engineer ] && [ -x "$native" ] || {
      echo "Refusing foreign omp symlink or missing retained native binary" >&2; exit 1;
    }
  else
    [ -f "$entry" ] && [ -x "$entry" ] && [ ! -e "$native" ] || {
      echo "Expected an executable native omp and an unused native destination" >&2; exit 1;
    }
    [ "$(od -An -tx1 -N4 "$entry" | tr -d ' \n')" = 7f454c46 ] || {
      echo "Refusing to replace a non-ELF omp entrypoint" >&2; exit 1;
    }
    case "$("$entry" --version)" in
      omp/[0-9]*) ;;
      *) echo "Refusing an unrecognised native omp binary" >&2; exit 1 ;;
    esac
  fi
  unit="$HOME/.config/systemd/user/omp.slice"
  if [ -e "$unit" ] || [ -L "$unit" ]; then
    [ ! -L "$unit" ] && [ "$(IFS= read -r line < "$unit"; printf '%s' "$line")" = \
      '# owned by misty-step/harness omp-config engineer-cage' ] || {
      echo "Refusing foreign omp.slice configuration" >&2; exit 1;
    }
  fi
}

install_engineer_cage() {
  # Explicit live cutover of future starts only. Never relocate running PIDs.
  install_cli
  install -d -m 700 "$HOME/.config/systemd/user" "$HOME/.local/lib/omp-engineer"
  install -m 600 "$repo_dir/units/omp.slice" "$HOME/.config/systemd/user/omp.slice"
  systemctl --user daemon-reload
  systemctl --user start omp.slice
  # Refresh a populated former 36-GiB parent in place; start is inert if active.
  # The source unit persists infinity; this only converges its live property.
  systemctl --user set-property --runtime omp.slice MemoryMax=infinity
  "$HOME/.local/bin/omp-engineer" memory --json
  entry="$HOME/.local/bin/omp"
  native="$HOME/.local/lib/omp-engineer/omp"
  if [ ! -L "$entry" ]; then
    mv -- "$entry" "$native"
    ln -s omp-engineer "$entry"
  fi
}

install_cli() {
  install -d -m 700 "$HOME/.local/bin"
  install -m 700 "$repo_dir/bin/omp-engineer.py" "$HOME/.local/bin/omp-engineer"
  install -m 700 "$repo_dir/bin/omp-display.py" "$HOME/.local/bin/omp-display"
  install -m 700 "$repo_dir/bin/omp-gui.py" "$HOME/.local/bin/omp-gui"
  install -m 700 "$repo_dir/bin/omp-host-install.py" "$HOME/.local/bin/omp-host-install"
}


if [ "${OMP_INSTALL_GUIDANCE_ONLY+x}" = x ]; then
  printf 'OMP_INSTALL_GUIDANCE_ONLY was replaced; use OMP_INSTALL_COMPONENTS=guidance\n' >&2
  exit 1
fi

# Split the explicit component list without expanding filesystem patterns.
set -f
set -- ${OMP_INSTALL_COMPONENTS-all}
set +f
[ "$#" -gt 0 ] || { echo "OMP_INSTALL_COMPONENTS must not be empty" >&2; exit 1; }

# Reject the entire selection before deploying anything.
for component do
  case $component in
    all)
      [ "$#" -eq 1 ] || { echo "all must be the only component" >&2; exit 1; }
      validate_config
      validate_guidance
      validate_mcp
      validate_shared
      validate_agents
      validate_themes
      validate_audio_sandbox
      validate_cli
      ;;
    guidance) validate_guidance ;;
    config) validate_config ;;
    mcp) validate_mcp ;;
    agents) validate_agents ;;
    extensions) require_bun ;;
    secrets) validate_secrets ;;
    audio-sandbox) validate_audio_sandbox ;;
    cli) validate_cli ;;
    engineer-cage) validate_engineer_cage ;;
    skill:*) validate_skill "${component#skill:}" ;;
    *)
      printf 'Unknown install component: %s\n' "$component" >&2
      exit 1
      ;;
  esac
done

if [ "$1" != all ]; then
  for component do
    case $component in
      guidance) install_guidance ;;
      config) install_config ;;
      mcp) install_mcp ;;
      agents) install_agents ;;
      extensions) install_extensions ;;
      secrets) install_secrets ;;
      audio-sandbox) install_audio_sandbox ;;
      cli) install_cli ;;
      engineer-cage) install_engineer_cage ;;
      skill:*) install_skill "${component#skill:}" ;;
    esac
  done
  printf 'Installed OMP components (%s) in %s; other deployed state unchanged\n' "$*" "$agent_dir"
  exit 0
fi

install_config
install_themes
install_guidance
install_agents
install_mcp
install_shared
install_extensions
install_audio_sandbox
install_cli

printf 'Installed owned OMP config in %s; foreign packages and runtime keys preserved\n' "$agent_dir"
